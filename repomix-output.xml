  position: absolute;
  top: -4px;
  right: -6px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  background: var(--color-danger);
  color: white;
  font-size: 10px;
  font-weight: 700;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.mobile-nav-label {
  font-size: 10px;
  font-weight: 500;
  margin-top: 2px;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.mobile-nav-compose {
  position: relative;
  margin-top: -20px;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: white;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
  transition: all 0.2s ease;
}

.mobile-nav-compose:active {
  transform: scale(0.92);
  box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
}

.mobile-nav-compose svg {
  width: 22px;
  height: 22px;
}

/* ====================================
   ADMIN COMPACT NAVIGATION (Mobile)
   ==================================== */

