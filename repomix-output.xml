<div class="ephemera-app">
    <h1>📧 Ephemera Email</h1>

    <div id="alert-container"></div>

    <!-- Usage Stats -->
    <div class="stats-row">
        <div class="stat-card">
            <h3 id="mailbox-count">-</h3>
            <p>Email Accounts</p>
        </div>
        <div class="stat-card">
            <h3 id="storage-used">-</h3>
            <p>Storage Used</p>
        </div>
        <div class="stat-card">
            <h3 id="message-count">-</h3>
            <p>Total Messages</p>
        </div>
    </div>

    <!-- Mailbox Management -->
    <div class="mailbox-section">
        <div class="mailbox-header">
            <h2>Email Accounts</h2>
            <button class="btn btn-primary" onclick="showCreateModal()">
                + Create Email Account
            </button>
        </div>

        <table class="mailbox-table" id="mailbox-table">
            <thead>
                <tr>
                    <th>Email Address</th>
                    <th>Display Name</th>
                    <th>Quota</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="mailbox-list">
                <tr><td colspan="4">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Create Mailbox Modal -->
<div class="modal" id="createModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Create Email Account</h3>
        </div>
        <form id="create-form" onsubmit="createMailbox(event)">
            <div class="modal-body">
                <div class="form-group">
                    <label>Email Address</label>
                    <div class="input-group">
                        <input type="text" name="local_part" id="local_part" required pattern="[a-zA-Z0-9._-]+">
                        <span class="input-group-addon">@</span>
                        <select name="domain" id="domain" style="flex:1"></select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" id="password" required minlength="8">
                </div>
                <div class="form-group">
                    <label>Display Name (optional)</label>
                    <input type="text" name="display_name" id="display_name">
                </div>
                <div class="form-group">
                    <label>Quota (MB)</label>
                    <input type="number" name="quota_mb" id="quota_mb" value="1024" min="100">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" onclick="hideModal('createModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

<!-- Password Change Modal -->
<div class="modal" id="passwordModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Change Password</h3>
        </div>
        <form id="password-form" onsubmit="changePassword(event)">
            <div class="modal-body">
                <input type="hidden" name="email" id="pw_email">
                <p>Changing password for: <strong id="pw_email_display"></strong></p>
                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" name="new_password" id="new_password" required minlength="8">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" onclick="hideModal('passwordModal')">Cancel</button>
                <button type="submit" class="btn btn-warning">Change Password</button>
            </div>
        </form>
    </div>
</div>

<script>
// API base URL (relative to cPanel)
var API_BASE = 'api.cgi';

// Load data on page load
document.addEventListener('DOMContentLoaded', function() {
    loadMailboxes();
    loadUsage();
    loadDomains();
});

function showAlert(message, type) {
    var container = document.getElementById('alert-container');
    container.innerHTML = '<div class="alert alert-' + type + '">' + message + '</div>';
    setTimeout(function() { container.innerHTML = ''; }, 5000);
}

function loadMailboxes() {
    fetch(API_BASE + '?action=list_mailboxes')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var tbody = document.getElementById('mailbox-list');
            if (data.success && data.mailboxes && data.mailboxes.length > 0) {
                tbody.innerHTML = data.mailboxes.map(function(m) {
                    return '<tr>' +
                        '<td>' + m.email + '</td>' +
                        '<td>' + (m.displayName || '-') + '</td>' +
                        '<td>' + (m.quotaMb || 1024) + ' MB</td>' +
                        '<td>' +
                            '<button class="btn btn-sm btn-success" onclick="openWebmail(\'' + m.email + '\')">Webmail</button> ' +
                            '<button class="btn btn-sm btn-warning" onclick="showPasswordModal(\'' + m.email + '\')">Password</button> ' +
                            '<button class="btn btn-sm btn-danger" onclick="deleteMailbox(\'' + m.email + '\')">Delete</button>' +
                        '</td>' +
                    '</tr>';
                }).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="4">No email accounts yet. Create one to get started!</td></tr>';
            }
        })
        .catch(function(err) {
            console.error('Error loading mailboxes:', err);
        });
}

function loadUsage() {
    fetch(API_BASE + '?action=get_usage')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                document.getElementById('mailbox-count').textContent = data.usage.mailboxes || 0;
                document.getElementById('message-count').textContent = data.usage.messages || 0;
                document.getElementById('storage-used').textContent = formatBytes(data.usage.storageBytes || 0);
            }
        });
}

function loadDomains() {
    fetch(API_BASE + '?action=list_domains')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var select = document.getElementById('domain');
            if (data.success && data.domains) {
                select.innerHTML = data.domains.map(function(d) {
                    return '<option value="' + d.domainName + '">' + d.domainName + '</option>';
                }).join('');
            }
        });
}

function showCreateModal() {
    document.getElementById('createModal').style.display = 'block';
}

function hideModal(id) {
    document.getElementById(id).style.display = 'none';
}

function createMailbox(e) {
    e.preventDefault();
    var form = e.target;
    var data = {
        action: 'create_mailbox',
        local_part: form.local_part.value,
        domain: form.domain.value,
        password: form.password.value,
        display_name: form.display_name.value,
        quota_mb: form.quota_mb.value
    };

    fetch(API_BASE, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(function(r) { return r.json(); })
    .then(function(result) {
        if (result.success) {
            showAlert('Email account created successfully!', 'success');
            hideModal('createModal');
            form.reset();
            loadMailboxes();
            loadUsage();
        } else {
            showAlert('Error: ' + result.error, 'error');
        }
    });
}

function showPasswordModal(email) {
    document.getElementById('pw_email').value = email;
    document.getElementById('pw_email_display').textContent = email;
    document.getElementById('passwordModal').style.display = 'block';
}

function changePassword(e) {
    e.preventDefault();
    var form = e.target;
    var data = {
        action: 'change_password',
        email: form.email.value,
        password: form.new_password.value
    };

    fetch(API_BASE, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(function(r) { return r.json(); })
    .then(function(result) {
        if (result.success) {
            showAlert('Password changed successfully!', 'success');
            hideModal('passwordModal');
            form.reset();
        } else {
            showAlert('Error: ' + result.error, 'error');
        }
    });
}

function deleteMailbox(email) {
    if (!confirm('Are you sure you want to delete ' + email + '? This cannot be undone.')) {
        return;
    }

    fetch(API_BASE, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete_mailbox', email: email })
    })
    .then(function(r) { return r.json(); })
    .then(function(result) {
        if (result.success) {
            showAlert('Email account deleted.', 'success');
            loadMailboxes();
            loadUsage();
        } else {
            showAlert('Error: ' + result.error, 'error');
        }
    });
}

function openWebmail(email) {
    window.open('/webmail/' + encodeURIComponent(email), '_blank');
}

function formatBytes(bytes) {
    if (bytes === 0) return '0 B';
    var k = 1024;
    var sizes = ['B', 'KB', 'MB', 'GB'];
    var i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
}

// Close modal on outside click
window.onclick = function(e) {
    if (e.target.classList.contains('modal')) {
        e.target.style.display = 'none';
    }
};
</script>

[% END %]
</file>

