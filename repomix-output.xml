      update: vi.fn(),
    },
    outboundMessage: {
      create: vi.fn(),
      update: vi.fn(),
    },
  },
}));

vi.mock('../../services/outbound', () => ({
  outboundService: {
    sendEmail: vi.fn(),
  },
}));

vi.mock('../../services/credit.service', () => ({
  CreditService: {
    deductCredits: vi.fn(),
    addCredits: vi.fn(),
  },
}));

vi.mock('../../services/team.service', () => ({
