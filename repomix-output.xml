/* ====================================
   PUBLIC LAYOUT STYLES
   ==================================== */

.public-layout {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  overflow-y: auto;
}

.public-main {
  flex: 1;
  padding-top: var(--header-height);
}

/* ====================================
   AUTH LAYOUT STYLES  
   ==================================== */

.auth-layout {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  overflow-y: auto;
  position: relative;
}

.auth-main {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  padding-top: calc(var(--header-height) + 2rem);
  position: relative;
  z-index: 1;
}

.auth-card-wrapper {
  display: flex;
  gap: 2rem;
  max-width: 1000px;
  width: 100%;
  background: var(--color-surface);
  border-radius: var(--border-radius-lg);
  box-shadow: var(--shadow-xl);
  overflow: hidden;
}

@media (max-width: 768px) {
  .auth-card-wrapper {
    flex-direction: column;
    max-width: 450px;
  }

  .auth-decoration {
    display: none;
  }
}

/* ====================================
   LEGAL PAGE CONTENT STYLES
   ==================================== */

.legal-content {
  max-width: 800px;
  margin: 0 auto;
  padding: 3rem 1.5rem 4rem;
}

.legal-content h1 {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.legal-content .legal-updated {
  color: var(--color-text-muted);
  font-size: 0.9rem;
  margin-bottom: 2.5rem;
}

.legal-content section {
  margin-bottom: 2rem;
}

.legal-content h2 {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 0.75rem;
}

.legal-content p {
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 1rem;
}

.legal-content ul {
  color: var(--color-text-secondary);
  padding-left: 1.5rem;
  margin-bottom: 1rem;
}

.legal-content li {
  margin-bottom: 0.5rem;
  line-height: 1.6;
}

.legal-content a {
  color: var(--color-primary);
  text-decoration: none;
}

.legal-content a:hover {
  text-decoration: underline;
}

.legal-nav {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
  display: flex;
  gap: 2rem;
}

.legal-nav a {
  color: var(--color-primary);
  text-decoration: none;
  font-weight: 500;
}

.legal-nav a:hover {
  text-decoration: underline;
}

/* ====================================
   DASHBOARD LAYOUT STYLES
   ==================================== */

.dashboard-with-header {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pane-layout {
  flex: 1;
  display: grid;
  grid-template-columns: 280px minmax(380px, 420px) 1fr;
  height: calc(100vh - var(--header-height));
  overflow: hidden;
}

/* Sidebar Pane */
.pane-layout>div:first-child {
  min-width: 260px;
  max-width: 320px;
}

/* Message List Pane */
.pane-layout>div:nth-child(2) {
  min-width: 350px;
  max-width: 500px;
  border-right: 1px solid var(--color-border);
}

/* Message Detail Pane */
.pane-layout>div:nth-child(3) {
  min-width: 400px;
  flex: 1;
}

/* Responsive: Hide sidebar on small screens */
@media (max-width: 1024px) {
  .pane-layout {
    grid-template-columns: minmax(320px, 400px) 1fr;
  }

  .pane-layout>div:first-child {
    display: none;
  }
}

@media (max-width: 768px) {
  .pane-layout {
    grid-template-columns: 1fr;
  }

  .pane-layout>div:nth-child(2),
  .pane-layout>div:nth-child(3) {
    display: none;
  }
}

/* Email Item Enhancements */
.email-item {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--color-border);
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-smooth);
}

.email-item:hover {
  background-color: var(--color-bg);
}

.email-item.selected {
  background-color: var(--color-primary-light);
  border-left: 3px solid var(--color-primary);
}

.email-item-sender {
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 0.25rem;
}

.email-item-subject {
  font-size: 14px;
  color: var(--color-text-main);
  margin-bottom: 0.25rem;
}

.email-item-preview {
  font-size: 13px;
  color: var(--color-text-muted);
  line-height: 1.5;
}

/* Action buttons overlay */
.email-item-actions {
  position: absolute;
  right: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0;
  transition: opacity var(--duration-fast) var(--ease-smooth);
  background: var(--color-surface);
  padding: 0.25rem;
  border-radius: var(--border-radius-md);
  box-shadow: var(--shadow-md);
  border: 1px solid var(--color-border);
}

.email-item:hover .email-item-actions {
  opacity: 1;
}

/* ====================================
   SITE NAVIGATION (Public)
   ==================================== */
.site-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-border);
  transition: all 0.3s ease;
}

[data-theme="dark"] .site-nav {
  background: rgba(10, 10, 11, 0.7);
}

.site-nav-auth {
  background: transparent;
  border-bottom: none;
}

.site-nav-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.site-nav-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: var(--color-text-main);
}

.site-nav-logo-icon {
  width: 36px;
  height: 36px;
  background: var(--gradient-primary);
  border-radius: var(--border-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.site-nav-logo-text {
  font-size: 1.25rem;
  font-weight: 700;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.site-nav-links {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.site-nav-link {
  color: var(--color-text-muted);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 500;
  transition: color var(--duration-fast) var(--ease-smooth);
}

.site-nav-link:hover {
  color: var(--color-primary);
}

.btn-nav-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.25rem;
  background: var(--gradient-primary);
  color: white;
  border: none;
  border-radius: var(--border-radius-full);
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-smooth);
  box-shadow: var(--shadow-md);
}

.btn-nav-primary:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-lg), var(--shadow-glow);
}

/* Mobile Hamburger */
.site-nav-hamburger {
  display: none;
  background: transparent;
  border: none;
  color: var(--color-text-main);
  cursor: pointer;
  padding: 0.5rem;
}

/* Mobile Menu */
.site-nav-mobile {
  position: fixed;
  top: 0;
  right: 0;
  width: 280px;
  height: 100vh;
  background: var(--color-surface);
  box-shadow: -10px 0 30px rgba(0, 0, 0, 0.2);
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 102;
  padding: 6rem 1.5rem 2rem;
  border-left: 1px solid var(--color-border);
}

.site-nav-mobile.open {
  transform: translateX(0);
}

.site-nav-mobile-links {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.site-nav-mobile-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--color-text-main);
  text-decoration: none;
}

.site-nav-mobile-divider {
  height: 1px;
  background: var(--color-border);
  margin: 0.5rem 0;
}

.site-nav-mobile-cta {
  justify-content: center;
  padding: 0.75rem;
  background: var(--gradient-primary);
  color: white;
  border-radius: var(--border-radius-lg);
}

.site-nav-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 101;
  animation: fadeIn 0.2s ease-out;
}

@media (max-width: 768px) {
  .site-nav-links {
    display: none;
  }

  .site-nav-hamburger {
    display: block;
  }
}

/* ====================================
   MOBILE OPTIMIZATION (Nebula Glass)
   ==================================== */

.mobile-nav-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 64px;
  max-width: 600px;
  margin: 0 auto;
