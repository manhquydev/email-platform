            payload: z.string(),
            signature: z.string(),
            secret: z.string(),
          }),
        },
      },
    },
  },
  responses: {
    200: {
      description: 'Verification result',
      content: {
        'application/json': {
          schema: z.object({
            valid: z.boolean(),
          }),
        },
      },
    },
  },
});
