<file path="services/backup/Dockerfile">
FROM alpine:3.19

# Install dependencies
RUN apk add --no-cache \
    bash \
    docker-cli \
    aws-cli \
    gzip \
    curl

# Setup script
COPY scripts/backup.sh /usr/local/bin/backup.sh
RUN chmod +x /usr/local/bin/backup.sh

# Create backup directory
WORKDIR /backups

# Add cron job (default: every 6 hours)
ENV CRON_SCHEDULE="0 */6 * * *"
RUN echo "$CRON_SCHEDULE /usr/local/bin/backup.sh --s3 >> /var/log/backup.log 2>&1" > /etc/crontabs/root

# Run cron in foreground
CMD ["crond", "-f"]
</file>

<file path="services/dovecot/conf.d/10-auth.conf">
# Authentication configuration
# Use SQL for password and user lookup

passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}

userdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}

# Allow plaintext auth when using TLS
auth_verbose = yes
auth_debug = no

# Service configuration for auth
service auth {
  unix_listener auth-userdb {
    mode = 0660
  }
}
</file>

<file path="services/dovecot/conf.d/10-mail.conf">
# Mail location and namespace configuration

mail_location = maildir:/var/mail/%d/%n

# Primary namespace
namespace inbox {
  inbox = yes
  location = 
  mailbox Drafts {
    auto = subscribe
    special_use = \Drafts
  }
  mailbox Sent {
    auto = subscribe
    special_use = \Sent
  }
  mailbox Trash {
    auto = subscribe
    special_use = \Trash
  }
  mailbox Spam {
    auto = subscribe
    special_use = \Junk
  }
  mailbox Archive {
    auto = no
    special_use = \Archive
  }
  prefix = 
  separator = /
}

# Mail process settings
mail_uid = vmail
mail_gid = vmail
mail_privileged_group = vmail

# Permissions
mail_access_groups = 

# First valid UID/GID values for mail users
first_valid_uid = 1000
first_valid_gid = 1000
</file>

<file path="services/dovecot/conf.d/10-ssl.conf">
# SSL/TLS configuration

ssl = required
ssl_cert = </etc/ssl/certs/dovecot.pem
ssl_key = </etc/ssl/private/dovecot.pem

# Minimum protocol version
ssl_min_protocol = TLSv1.2

# Prefer server cipher order
ssl_prefer_server_ciphers = yes

# DH parameters
ssl_dh = </etc/dovecot/dh.pem
</file>

<file path="services/dovecot/conf.d/20-imap.conf">
# IMAP protocol configuration

protocol imap {
  mail_plugins = 
  mail_max_userip_connections = 10
  imap_idle_notify_interval = 2 mins
}
</file>

<file path="services/dovecot/conf.d/20-lmtp.conf">
# LMTP service configuration
# Used to receive mail from Postfix or SMTP server

protocol lmtp {
  mail_plugins =
  postmaster_address = postmaster@%{hostname}
}

service lmtp {
  # TCP listener for Docker container networking (Postfix connects via this)
  inet_listener lmtp {
    address = *
    port = 24
  }
}
</file>

