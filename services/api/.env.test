# Test Environment Configuration
NODE_ENV=test

# Database (using test database)
DATABASE_URL="postgresql://postgres:password@localhost:5432/tempmail_test"

# Redis
REDIS_URL="redis://localhost:6379/1"

# JWT
JWT_SECRET="test-jwt-secret-key"

# AWS (using test credentials)
AWS_REGION_US_EAST="us-east-1"
AWS_REGION_EU_WEST="eu-west-1"
AWS_REGION_AP_SOUTHEAST="ap-southeast-1"

# Multi-region settings
AUTO_SCALING="true"
LOAD_BALANCER_URL="https://test-tempmail.pro"

# Analytics
ANALYTICS_API_KEY="test-analytics-key"

# SSO
SAML_PRIVATE_KEY="test-private-key"
SAML_PUBLIC_KEY="test-public-key"

# ML Models
SPAM_MODEL_PATH="./tests/fixtures/spam-model"

# Other test settings
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER="test"
SMTP_PASS="test"
DOMAIN_NAME="test.tempmail.pro"