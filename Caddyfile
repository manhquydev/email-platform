# Caddyfile - Production Reverse Proxy với HTTPS tự động
# ===================================================
# Sử dụng: Đặt biến môi trường DOMAIN trước khi chạy
# Ví dụ: DOMAIN=example.com docker-compose -f docker-compose.prod.yml up -d

{
	# Email cho Let's Encrypt notifications
	email {$ACME_EMAIL}
}

# API Backend - api.yourdomain.com
api.{$DOMAIN} {
	reverse_proxy api:3001

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Logging
	log {
		output stdout
		format json
	}
}

# Web Frontend - app.yourdomain.com
app.{$DOMAIN} {
	reverse_proxy web:80

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Grafana Dashboard - grafana.yourdomain.com
grafana.{$DOMAIN} {
	reverse_proxy grafana:3000

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Prometheus - metrics.yourdomain.com
prometheus.{$DOMAIN} {
	reverse_proxy prometheus:9090

	header {
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Root domain redirect to app subdomain
{$DOMAIN} {
	redir https://app.{$DOMAIN}{uri} permanent
}

# HTTP to HTTPS redirect (automatic with Caddy)
