  createdAt          DateTime  @default(now())
  lastSuccessfulSend DateTime? // Track for stale subscription pruning

  @@index([userId])
  @@index([lastSuccessfulSend])
}

// Phase 11: Support Ticket System

enum TicketStatus {
  OPEN
  WAITING_USER
  WAITING_SUPPORT
  RESOLVED
  CLOSED
}

enum TicketPriority {
