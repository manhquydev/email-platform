/* === ANIMATED MESH GRADIENT BACKGROUNDS === */
.neo-mesh-bg {
    position: relative;
    overflow: hidden;
}

.neo-mesh-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
        radial-gradient(ellipse 80% 50% at 20% 40%, var(--neo-mesh-violet) 0%, transparent 50%),
        radial-gradient(ellipse 60% 40% at 80% 20%, var(--neo-mesh-cyan) 0%, transparent 50%),
        radial-gradient(ellipse 50% 60% at 10% 90%, var(--neo-mesh-pink) 0%, transparent 50%),
        radial-gradient(ellipse 70% 50% at 90% 70%, var(--neo-mesh-blue) 0%, transparent 50%);
    animation: neo-mesh-float 25s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
}

@keyframes neo-mesh-float {

    0%,
    100% {
        transform: translate(0, 0) scale(1);
    }

    25% {
        transform: translate(2%, -2%) scale(1.02);
    }

    50% {
        transform: translate(-1%, 2%) scale(0.98);
    }

    75% {
        transform: translate(-2%, -1%) scale(1.01);
    }
}

/* Animated Blob Orbs */
.neo-blob-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.6;
    animation: neo-blob-pulse 8s ease-in-out infinite;
}

.neo-blob-orb-violet {
    background: linear-gradient(135deg, #8B5CF6, #A78BFA);
}

.neo-blob-orb-cyan {
    background: linear-gradient(135deg, #06B6D4, #22D3EE);
    animation-delay: -2s;
}

.neo-blob-orb-pink {
    background: linear-gradient(135deg, #EC4899, #F472B6);
    animation-delay: -4s;
}

@keyframes neo-blob-pulse {

    0%,
    100% {
        transform: scale(1) translate(0, 0);
        opacity: 0.5;
    }

    33% {
        transform: scale(1.1) translate(5%, -5%);
        opacity: 0.6;
    }

    66% {
        transform: scale(0.9) translate(-3%, 3%);
        opacity: 0.4;
    }
}

/* === MICRO-ANIMATIONS === */
@keyframes neo-fade-in-up {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes neo-fade-in-scale {
    from {
        opacity: 0;
        transform: scale(0.95);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

@keyframes neo-slide-in-right {
    from {
        opacity: 0;
        transform: translateX(30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes neo-spring-pop {
    0% {
        transform: scale(0.8);
    }

    50% {
        transform: scale(1.05);
    }

    100% {
        transform: scale(1);
    }
}

@keyframes neo-float {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-8px);
    }
}

@keyframes neo-shimmer {
    0% {
        background-position: -200% 0;
    }

    100% {
        background-position: 200% 0;
    }
}

@keyframes neo-glow-pulse {

    0%,
    100% {
        box-shadow: var(--neo-glow-violet-soft);
    }

    50% {
        box-shadow: var(--neo-glow-violet-medium);
    }
}

@keyframes neo-rotate-slow {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

/* Animation Utilities */
.neo-animate-fade-in-up {
    animation: neo-fade-in-up var(--neo-duration-medium) var(--neo-spring-smooth) forwards;
}

.neo-animate-fade-in-scale {
    animation: neo-fade-in-scale var(--neo-duration-medium) var(--neo-spring-smooth) forwards;
}

.neo-animate-slide-in-right {
    animation: neo-slide-in-right var(--neo-duration-medium) var(--neo-spring-smooth) forwards;
}

.neo-animate-spring-pop {
    animation: neo-spring-pop var(--neo-duration-medium) var(--neo-spring-bounce) forwards;
}

.neo-animate-float {
    animation: neo-float 3s ease-in-out infinite;
}

.neo-animate-shimmer {
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    background-size: 200% 100%;
    animation: neo-shimmer 2s linear infinite;
}

.neo-animate-glow-pulse {
    animation: neo-glow-pulse 2s ease-in-out infinite;
}

/* Staggered Animation Delays */
.neo-stagger-1 {
    animation-delay: 0.1s;
}

.neo-stagger-2 {
    animation-delay: 0.2s;
}

.neo-stagger-3 {
    animation-delay: 0.3s;
}

.neo-stagger-4 {
    animation-delay: 0.4s;
}

.neo-stagger-5 {
    animation-delay: 0.5s;
}

/* === ENHANCED GLASSMORPHISM === */
.neo-glass {
    background: var(--neo-glass-bg-medium);
