/* Skeleton Loaders */
.skeleton-base {
  background: rgba(255, 255, 255, 0.05);
  background: linear-gradient(90deg,
      rgba(255, 255, 255, 0.05) 25%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.05) 75%);
  background-size: 200% 100%;
  animation: shimmer 2s infinite linear;
}

.inbox-card-skeleton {
  padding: 1rem;
  background: var(--neo-glass-bg);
  backdrop-filter: blur(var(--neo-glass-blur));
  border: 1px solid var(--neo-glass-border);
  border-radius: var(--radius-xl);
  margin-bottom: 1rem;
}

.message-item-skeleton {
  background: rgba(255, 255, 255, 0.02);
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}

/* =========================================
   AUTH LAYOUT SPECIFIC STYLES
   ========================================= */
.auth-layout {
  position: relative;
  min-height: 100vh;
  width: 100vw;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--nebula-void);
  color: var(--nebula-text);
}

.auth-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.auth-bg-gradient {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 15% 50%, rgba(76, 29, 149, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 85% 30%, rgba(6, 182, 212, 0.1) 0%, transparent 60%);
  backdrop-filter: blur(64px);
  -webkit-backdrop-filter: blur(64px);
}

.auth-bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 50px 50px;
  mask-image: radial-gradient(circle at center, black 40%, transparent 100%);
  opacity: 0.5;
}

.auth-bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.4;
  animation: float 10s ease-in-out infinite;
}

.auth-bg-glow-1 {
  top: -10%;
  left: -10%;
  width: 40vw;
  height: 40vw;
  background: var(--nebula-violet-light);
  animation-delay: 0s;
}

.auth-bg-glow-2 {
  bottom: -10%;
  right: -10%;
  width: 35vw;
  height: 35vw;
  background: var(--nebula-cyan);
  animation-delay: -5s;
}

.auth-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 10;
  width: 100%;
  padding: 2rem;
}

/* Auth Card Specifics - for wrapping forms */
.auth-card-container {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 420px;
  margin: auto;
  padding: 2rem;
}

.landing-nav-auth {
  background: transparent !important;
  backdrop-filter: none !important;
  border-bottom: none !important;
}

/* ====================================
   EMAIL CONTENT STYLES (Light/Dark Mode)
   ==================================== */

/* Base email content styles */
.email-content {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 0.95rem;
  line-height: 1.7;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

/* Light mode email content */
.email-content {
  color: var(--color-text-main, #1e293b);
  background-color: transparent;
}

.email-content a {
  color: var(--color-primary, #3b82f6);
  text-decoration: underline;
}

.email-content a:hover {
  color: var(--color-primary-hover, #2563eb);
}

.email-content img {
  max-width: 100%;
  height: auto;
  border-radius: var(--border-radius-sm, 6px);
}

.email-content table {
  border-collapse: collapse;
  width: 100%;
  margin: 1rem 0;
}

.email-content th,
.email-content td {
  border: 1px solid var(--color-border, #e2e8f0);
  padding: 0.5rem 0.75rem;
  text-align: left;
}

.email-content th {
  background-color: var(--color-bg, #f8fafc);
  font-weight: 600;
}

.email-content blockquote {
  border-left: 4px solid var(--color-primary-border, #93c5fd);
  margin: 1rem 0;
  padding: 0.5rem 1rem;
  background-color: var(--color-primary-light, #eff6ff);
  color: var(--color-text-secondary, #475569);
  border-radius: 0 var(--border-radius-sm, 6px) var(--border-radius-sm, 6px) 0;
}

.email-content pre,
.email-content code {
  font-family: 'JetBrains Mono', 'Fira Code', Consolas, Monaco, monospace;
  font-size: 0.875rem;
  background-color: var(--color-bg, #f1f5f9);
  border-radius: var(--border-radius-sm, 6px);
}

.email-content pre {
  padding: 1rem;
  overflow-x: auto;
  border: 1px solid var(--color-border, #e2e8f0);
}

.email-content code {
  padding: 0.125rem 0.375rem;
}

.email-content hr {
  border: none;
  border-top: 1px solid var(--color-border, #e2e8f0);
  margin: 1.5rem 0;
}

.email-content h1,
.email-content h2,
.email-content h3,
.email-content h4,
.email-content h5,
.email-content h6 {
  color: var(--color-text-main, #0f172a);
  font-weight: 600;
  margin: 1.5rem 0 0.75rem;
  line-height: 1.3;
}

.email-content p {
  margin: 0.75rem 0;
}

.email-content ul,
.email-content ol {
  margin: 0.75rem 0;
  padding-left: 1.5rem;
}

.email-content li {
  margin: 0.25rem 0;
}

/* Dark mode email content */
[data-theme="dark"] .email-content,
.dark .email-content {
  color: var(--nebula-text, #f1f5f9);
}

[data-theme="dark"] .email-content a,
.dark .email-content a {
  color: var(--nebula-violet-light, #a78bfa);
}

[data-theme="dark"] .email-content a:hover,
.dark .email-content a:hover {
  color: var(--nebula-cyan, #22d3ee);
}

[data-theme="dark"] .email-content th,
[data-theme="dark"] .email-content td,
.dark .email-content th,
.dark .email-content td {
  border-color: var(--nebula-border, rgba(255, 255, 255, 0.08));
}

[data-theme="dark"] .email-content th,
.dark .email-content th {
  background-color: var(--nebula-surface, #12182b);
}

[data-theme="dark"] .email-content blockquote,
.dark .email-content blockquote {
  border-left-color: var(--nebula-violet, #8b5cf6);
  background-color: rgba(139, 92, 246, 0.1);
  color: var(--nebula-text-secondary, #94a3b8);
}

[data-theme="dark"] .email-content pre,
[data-theme="dark"] .email-content code,
.dark .email-content pre,
.dark .email-content code {
  background-color: var(--nebula-elevated, #1a2340);
  color: var(--nebula-text, #f1f5f9);
}

[data-theme="dark"] .email-content pre,
.dark .email-content pre {
  border-color: var(--nebula-border, rgba(255, 255, 255, 0.08));
}

[data-theme="dark"] .email-content hr,
.dark .email-content hr {
  border-top-color: var(--nebula-border, rgba(255, 255, 255, 0.08));
}

[data-theme="dark"] .email-content h1,
[data-theme="dark"] .email-content h2,
[data-theme="dark"] .email-content h3,
[data-theme="dark"] .email-content h4,
[data-theme="dark"] .email-content h5,
[data-theme="dark"] .email-content h6,
.dark .email-content h1,
.dark .email-content h2,
.dark .email-content h3,
.dark .email-content h4,
.dark .email-content h5,
.dark .email-content h6 {
  color: var(--nebula-text, #f1f5f9);
}

/* Email content wrapper for proper containment */
.email-content-wrapper {
  background-color: var(--color-surface, #ffffff);
  border-radius: var(--border-radius-lg, 16px);
  padding: 1.5rem;
  border: 1px solid var(--color-border, #e2e8f0);
}

[data-theme="dark"] .email-content-wrapper,
.dark .email-content-wrapper {
  background-color: var(--nebula-surface, #12182b);
  border-color: var(--nebula-border, rgba(255, 255, 255, 0.08));
}
</file>

