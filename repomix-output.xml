              value: "6379"
            - name: STORAGE_DIR
              value: /app/storage
            - name: HTTP_PORT
              value: "3001"
            - name: SMTP_PORT
              value: "2525"
            - name: TRUST_PROXY
              value: "true"
            - name: WEB_URL
              valueFrom:
                configMapKeyRef:
                  name: tempmail-config
                  key: web-url
          resources:
            requests:
              memory: "256Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "500m"
          livenessProbe:
            httpGet:
              path: /health
              port: 3001
            initialDelaySeconds: 15
            periodSeconds: 20
          readinessProbe:
            httpGet:
              path: /ready
              port: 3001
            initialDelaySeconds: 5
            periodSeconds: 10
          volumeMounts:
            - name: storage
              mountPath: /app/storage
      volumes:
        - name: storage
          persistentVolumeClaim:
            claimName: api-storage-pvc
---
# API Service
