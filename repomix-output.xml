    left: 23px;
    top: 56px;
    width: 2px;
    height: calc(100% - 8px);
    background: var(--nebula-border);
}

/* Pricing */
.landing-pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--nebula-space-lg);
    max-width: 900px;
