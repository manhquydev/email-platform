<script>
function promptPassword(email) {
    var password = prompt('Enter new password for ' + email + ' (min 8 characters):');
    if (password && password.length >= 8) {
        window.location.href = '<?= $this->url(['action' => 'change-password']) ?>&email=' + encodeURIComponent(email) + '&password=' + encodeURIComponent(password) + '&domain=<?= urlencode($this->domain) ?>';
    } else if (password) {
        alert('Password must be at least 8 characters');
    }
    return false;
}
</script>
