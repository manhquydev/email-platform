                </svg>
            ),
            label: "Xóa",
            onClick: onDelete,
            color: "text-danger",
        },
    ];

    const style = position ? {
        position: 'fixed' as const,
        left: position.x,
        top: position.y,
        zIndex: 50,
    } : {};

    return (
        <div
            className="glass rounded-xl shadow-lg p-1.5 animate-scale-in flex items-center gap-0.5"
