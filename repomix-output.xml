}

.neo-glass-heavy {
    background: var(--neo-glass-bg-heavy);
    backdrop-filter: var(--neo-glass-blur-heavy) saturate(200%);
    -webkit-backdrop-filter: var(--neo-glass-blur-heavy) saturate(200%);
