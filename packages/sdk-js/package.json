{
  "name": "@ephemera/sdk",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for Ephemera temporary email platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["ephemera", "email", "temporary-email", "disposable-email", "testing", "sdk"],
  "author": "Ephemera Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ephemera-email/sdk-js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
