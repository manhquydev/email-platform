                    </div>
                    <div>
                        <div className="otp-card-name">{account.serviceName}</div>
                        <div className="otp-card-account">{account.accountName || 'N/A'}</div>
                    </div>
                </div>
                <div className="otp-card-timer">
                    <span>{timeLeft}</span>
                    <svg className="otp-card-timer-ring" viewBox="0 0 36 36">
