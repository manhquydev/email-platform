<file path="services/web/src/styles/mobile-safe-area.css">
/* Mobile Safe Area CSS - iOS/Android notch and home indicator support */

/* Safe area padding utilities */
.safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom, 0);
}

.safe-area-top {
    padding-top: env(safe-area-inset-top, 0);
}

.safe-area-left {
    padding-left: env(safe-area-inset-left, 0);
}

.safe-area-right {
    padding-right: env(safe-area-inset-right, 0);
}

/* Combined safe area utilities */
.safe-area-x {
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
}

.safe-area-y {
    padding-top: env(safe-area-inset-top, 0);
    padding-bottom: env(safe-area-inset-bottom, 0);
}

.safe-area-all {
    padding-top: env(safe-area-inset-top, 0);
    padding-right: env(safe-area-inset-right, 0);
    padding-bottom: env(safe-area-inset-bottom, 0);
    padding-left: env(safe-area-inset-left, 0);
}

/* Margin variants */
.safe-margin-bottom {
    margin-bottom: env(safe-area-inset-bottom, 0);
}

.safe-margin-top {
    margin-top: env(safe-area-inset-top, 0);
}

/* Min-height accounting for safe areas */
.min-h-screen-safe {
    min-height: calc(100vh - env(safe-area-inset-top, 0) - env(safe-area-inset-bottom, 0));
}

/* Fixed bottom positioning with safe area */
.fixed-bottom-safe {
    bottom: env(safe-area-inset-bottom, 0);
}

/* Mobile viewport height fix for iOS Safari */
@supports (-webkit-touch-callout: none) {
    .min-h-screen {
        min-height: -webkit-fill-available;
    }
}
