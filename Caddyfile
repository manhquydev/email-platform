# Caddyfile - Production Reverse Proxy với HTTPS tự động
# ===================================================
# Sử dụng: Đặt biến môi trường DOMAIN trước khi chạy
# Ví dụ: DOMAIN=example.com docker-compose -f docker-compose.prod.yml up -d

{
	# Email cho Let's Encrypt notifications
	email {$ACME_EMAIL}
}

# API Backend - api.yourdomain.com
api.{$DOMAIN} {
	# Handle CORS preflight requests
	@options method OPTIONS
	handle @options {
		header Access-Control-Allow-Origin https://app.{$DOMAIN}
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, x-csrf-token, x-api-key"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	# Add CORS headers to all responses
	header {
		Access-Control-Allow-Origin https://app.{$DOMAIN}
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, Accept, x-csrf-token, x-api-key"
		Access-Control-Allow-Credentials "true"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy api:3001

	# Logging
	log {
		output stdout
		format json
	}
}

# Web Frontend - app.yourdomain.com
app.{$DOMAIN} {
	# Proxy /api/* requests to API backend
	@api path /api/*
	handle @api {
		header {
			Access-Control-Allow-Origin https://app.{$DOMAIN}
			Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Authorization, Content-Type, Accept, x-csrf-token, x-api-key"
			Access-Control-Allow-Credentials "true"
		}
		reverse_proxy api:3001
	}

	# Proxy /realtime/* and /ws/* to API backend (SSE, WebSocket)
	@realtime path /realtime/* /ws/*
	handle @realtime {
		header {
			Access-Control-Allow-Origin https://app.{$DOMAIN}
			Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Authorization, Content-Type, Accept, x-csrf-token, x-api-key"
			Access-Control-Allow-Credentials "true"
		}
		reverse_proxy api:3001
	}

	# All other requests go to web frontend
	handle {
		reverse_proxy web:80
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Cache Control - Fix Stale Cache Issue
	# 1. No Cache for index.html and service worker
	@noCache {
		path /
		path /index.html
		path /sw.js
		path /version.json
		path /config.js
	}
	header @noCache Cache-Control "no-cache, no-store, must-revalidate"

	# 2. Long Cache for static assets (hashed by Vite)
	@static {
		path /assets/*
		path /images/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format json
	}
}

# Grafana Dashboard - grafana.yourdomain.com
grafana.{$DOMAIN} {
	reverse_proxy grafana:3000

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Prometheus - metrics.yourdomain.com
prometheus.{$DOMAIN} {
	reverse_proxy prometheus:9090

	header {
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Root domain redirect to app subdomain
{$DOMAIN} {
	redir https://app.{$DOMAIN}{uri} permanent
}

# HTTP to HTTPS redirect (automatic with Caddy)
