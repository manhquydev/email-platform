# Redis Service
apiVersion: v1
kind: Service
metadata:
  name: redis-service
  labels:
    app: tempmail
    component: redis
spec:
  selector:
    app: tempmail
    component: redis
  ports:
    - port: 6379
      targetPort: 6379
  type: ClusterIP
