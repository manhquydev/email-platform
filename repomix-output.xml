    onCreateInbox, onFilterChange, onSortChange, loadMessages, navigate
}: LeftPaneProps) {
    return (
        <div className="h-full flex flex-col">
            {/* Header */}
            <div className="p-3 border-b border-white/5 bg-gradient-to-b from-white/[0.02] to-transparent">
