                    ''',
                    timeout=30
                )
                print(stdout.read().decode())
            else:
                print("\n⚠️ Check webhook configuration manually")
        else:
            print("❌ Bot token not found")
        
        client.close()
        
    except Exception as e:
        print(f"❌ Error: {e}")

