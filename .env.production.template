# Production Environment Template for manhquy.click
# ================================================
# Copy this file to ./services/api/.env and update values

# Database
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PASSWORD_HERE@postgres:5432/email_service"

# Security
JWT_SECRET="GENERATE_WITH_scripts/generate_env.sh"

# Server
HTTP_PORT=3001
SMTP_PORT=2525
TRUST_PROXY=true

# Admin Account
DEFAULT_ADMIN_EMAIL="manhquydev@gmail.com"
DEFAULT_ADMIN_PASSWORD="Manhquy203@"

# Storage
STORAGE_DIR="/app/storage"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Domain Settings
ALLOW_AUTO_DOMAIN_CREATION=false
WEB_URL=https://app.manhquy.click
API_URL=https://api.manhquy.click

# Extension CORS policy
# Recommended strict setup:
# CORS_ALLOWED_EXTENSIONS=hlkcmdhjbodafhlghcpojcaceahjjbmo
# CORS_REQUIRE_EXTENSION_WHITELIST=true
#
# Quick UX setup (default): allow extension access without explicit ID list
CORS_ALLOW_EXTENSION_ORIGINS=true
CORS_ALLOWED_EXTENSIONS=
CORS_REQUIRE_EXTENSION_WHITELIST=false

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"

# Quotas
MAX_ATTACHMENT_BYTES=5242880
QUOTA_MESSAGES_PER_INBOX=500
QUOTA_MESSAGES_PER_DOMAIN=5000

# Retention
MESSAGE_TTL_HOURS=168
INBOX_TTL_HOURS=168
RETENTION_SWEEP_MINUTES=5

# SMTP Rate Limiting
SMTP_RATE_WINDOW_MINUTES=5
SMTP_RATE_LIMIT_PER_IP=300
SMTP_RATE_LIMIT_PER_DOMAIN=500
SMTP_RATE_LIMIT_PER_INBOX=200
SPAM_CHECK_ENABLED=true
SPAM_CHECK_TIMEOUT_MS=2000
RSPAMD_URL="http://rspamd:11333"
INBOUND_WORKER_CONCURRENCY=4

# Attachments
ALLOWED_ATTACHMENT_MIME_PREFIXES="image/,text/plain,application/pdf"
ALLOWED_ATTACHMENT_EXTENSIONS="txt,eml,pdf,png,jpg,jpeg"

# Public Inbox (disabled by default)
PUBLIC_INBOX_ENABLED=false
REQUIRE_CAPTCHA_FOR_PUBLIC_INBOX=false
CAPTCHA_SECRET=""
PUBLIC_READY_ENDPOINT=false
PUBLIC_METRICS_ENDPOINT=false

# Outbound Email (Brevo API - recommended for VPS blocks outbound port 25)
# Set OUTBOUND_ENABLED=true only after BREVO_API_KEY is configured
OUTBOUND_ENABLED=false
OUTBOUND_PROVIDER="brevo"  # smtp | brevo | fallback
BREVO_API_KEY="xkeysib-REPLACE_ME"
# Optional SMTP fallback (only if OUTBOUND_PROVIDER=fallback)
OUTBOUND_SMTP_HOST=""
OUTBOUND_SMTP_PORT=587
OUTBOUND_SMTP_USER=""
OUTBOUND_SMTP_PASS=""
OUTBOUND_SMTP_SECURE=true

# Anti-Abuse
BLOCKED_SENDER_DOMAINS="spam.com,bad.test"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="TempMailProBot"
TELEGRAM_WEBHOOK_SECRET=""

# Email Forwarding & Account Verification SMTP
# Uses the same OUTBOUND_SMTP configuration above
# MAIL_DOMAIN is used for sender address (e.g. noreply@manhquy.click)
MAIL_DOMAIN="manhquy.click"
