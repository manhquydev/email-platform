<file path="services/web/src/styles/focus-stream.css">
/* ============================================
   FOCUS STREAM LAYOUT - Ephemera 2025
   Superhuman-inspired minimal inbox
   ============================================ */

/* Icon Rail - Expandable sidebar navigation */
.icon-rail {
    width: 64px;
    height: 100vh;
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    padding: 12px 10px;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 100;
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s ease, opacity 0.3s ease;
}

.icon-rail.expanded {
    width: 240px;
    padding: 12px 12px;
}

[data-theme="dark"] .icon-rail {
    background: #0A0A0B;
    border-right-color: rgba(255, 255, 255, 0.1);
}

/* Header with Logo and Toggle */
.icon-rail-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px;
    margin-bottom: 20px;
    min-height: 44px;
    gap: 8px;
}

.icon-rail-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-text-main);
    flex: 1;
    min-width: 0;
}

/* Center logo when collapsed */
.icon-rail:not(.expanded) .icon-rail-logo {
    justify-content: center;
}

.icon-rail-logo svg {
    width: 32px !important;
    height: 32px !important;
    min-width: 32px;
    max-width: 32px;
    flex-shrink: 0;
    padding: 6px;
    background: #0A0A0B;
    border-radius: 8px;
    color: white;
}

[data-theme="dark"] .icon-rail-logo svg {
    background: #0A0A0B;
}

.icon-rail-toggle svg {
    width: 16px !important;
    height: 16px !important;
    max-width: 16px;
    flex-shrink: 0;
}

.icon-rail-brand {
    font-size: 16px;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s ease;
}

.icon-rail.expanded .icon-rail-brand {
    opacity: 1;
}

.icon-rail-toggle {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.15s ease, background 0.15s ease;
}

.icon-rail:hover .icon-rail-toggle,
.icon-rail.expanded .icon-rail-toggle {
    opacity: 1;
}

.icon-rail-toggle:hover {
    background: var(--color-bg);
    color: var(--color-text-main);
}

[data-theme="dark"] .icon-rail-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
}

/* Main Navigation */
.icon-rail-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow-y: auto;
    overscroll-behavior: none;
    touch-action: pan-y;

}

.icon-rail-bottom {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: auto;
    padding-top: 8px;
}

/* Navigation Items */
.icon-rail-item {
    height: 42px;
    padding: 0 12px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 14px;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    text-decoration: none;
    white-space: nowrap;
}

/* Center icons when collapsed */
.icon-rail:not(.expanded) .icon-rail-item {
    justify-content: center;
    padding: 0;
}

.icon-rail-item:hover {
    background: var(--color-primary-light);
    color: var(--color-primary);
}

[data-theme="dark"] .icon-rail-item:hover {
    background: rgba(59, 130, 246, 0.15);
    color: #60A5FA;
}

.icon-rail-item.active {
    background: var(--color-primary-light);
    color: var(--color-primary);
}

[data-theme="dark"] .icon-rail-item.active {
    background: rgba(59, 130, 246, 0.2);
    color: #60A5FA;
}

.icon-rail-item svg {
    width: 20px !important;
    height: 20px !important;
    min-width: 20px;
    max-width: 20px;
    flex-shrink: 0;
}

.icon-rail-label {
    font-size: 14px;
    font-weight: 500;
    opacity: 0;
    transition: opacity 0.2s ease;
}

.icon-rail.expanded .icon-rail-label {
    opacity: 1;
}

.icon-rail-badge {
    position: absolute;
    top: 6px;
    left: 24px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    font-size: 10px;
    font-weight: 600;
    background: #EF4444;
    color: white;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.icon-rail.expanded .icon-rail-badge {
    position: static;
    margin-left: auto;
}

/* Separator */
.icon-rail-separator {
    height: 1px;
    background: var(--color-border);
    margin: 8px 10px;
}

[data-theme="dark"] .icon-rail-separator {
    background: rgba(255, 255, 255, 0.1);
}

/* User Avatar */
.icon-rail-avatar {
    width: 100%;
    height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 13px;
    font-weight: 600;
    text-align: left;
    position: relative;
}

/* Center avatar when collapsed */
.icon-rail:not(.expanded) .icon-rail-avatar {
    justify-content: center;
    padding: 0;
}

.icon-rail-avatar:hover {
    background: var(--color-primary-light);
}

[data-theme="dark"] .icon-rail-avatar:hover {
    background: rgba(59, 130, 246, 0.15);
}

/* Avatar circle with initial */
.icon-rail-avatar-circle {
    width: 34px;
    height: 34px;
    min-width: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 14px;
    font-weight: 600;
    flex-shrink: 0;
}

.icon-rail-user-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    opacity: 0;
    transition: opacity 0.2s ease;
    overflow: hidden;
}

.icon-rail.expanded .icon-rail-user-info {
    opacity: 1;
}

.icon-rail-user-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
}

.icon-rail-user-role {
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-muted);
}

/* User Menu Dropdown */
.user-menu-container {
    position: fixed;
    bottom: 70px;
    left: 72px;
    z-index: 200;
}

.focus-stream-layout.nav-expanded .user-menu-container {
    left: 228px;
}

.user-menu {
    background: var(--color-surface);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    border: 1px solid var(--color-border);
    overflow: hidden;
    min-width: 180px;
    animation: slideUp 0.15s ease;
}

[data-theme="dark"] .user-menu {
    background: #18181B;
    border-color: rgba(255, 255, 255, 0.1);
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.user-menu-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: none;
    background: transparent;
    color: var(--color-text-main);
    font-size: 14px;
    cursor: pointer;
    transition: background 0.15s ease;
    text-align: left;
}

.user-menu-item:hover {
    background: var(--color-primary-light);
}

[data-theme="dark"] .user-menu-item:hover {
    background: rgba(59, 130, 246, 0.15);
}

.user-menu-item--danger {
    color: #EF4444;
}

.user-menu-item--danger:hover {
    background: rgba(239, 68, 68, 0.1);
}

.user-menu-divider {
    height: 1px;
    background: var(--color-border);
    margin: 4px 0;
}

[data-theme="dark"] .user-menu-divider {
    background: rgba(255, 255, 255, 0.1);
}

/* Focus Mode Exit Button */
.focus-mode-exit {
    position: fixed;
    top: 16px;
    left: 16px;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: none;
    background: var(--color-surface);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    color: var(--color-text-main);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 150;
    transition: all 0.15s ease;
    animation: fadeIn 0.2s ease;
}

.focus-mode-exit:hover {
    background: var(--color-primary);
    color: white;
    transform: scale(1.05);
}

[data-theme="dark"] .focus-mode-exit {
    background: #18181B;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}

/* Command Palette - Superhuman-style quick actions */
.command-palette-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1000;
    animation: fadeIn 0.15s ease;
}

.command-palette {
    position: fixed;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 560px;
    background: var(--color-surface);
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    z-index: 1001;
    overflow: hidden;
    animation: slideDown 0.2s ease;
}

[data-theme="dark"] .command-palette {
    background: #18181B;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateX(-50%) translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }
}

.command-palette-input-wrapper {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-border);
    gap: 12px;
}

[data-theme="dark"] .command-palette-input-wrapper {
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.command-palette-input-wrapper svg {
    width: 20px;
    height: 20px;
    color: var(--color-text-muted);
    flex-shrink: 0;
}

.command-palette-input {
    flex: 1;
    font-size: 16px;
    border: none;
    background: transparent;
    color: var(--color-text-main);
    outline: none;
}

.command-palette-input::placeholder {
    color: var(--color-text-muted);
}

.command-palette-kbd {
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 500;
    background: var(--color-bg);
    border-radius: 6px;
    color: var(--color-text-muted);
    font-family: inherit;
}

[data-theme="dark"] .command-palette-kbd {
    background: rgba(255, 255, 255, 0.1);
}

.command-palette-results {
    max-height: 400px;
    overflow-y: auto;
    overscroll-behavior: none;
    touch-action: pan-y;

    padding: 8px;
}

.command-palette-group {
    margin-bottom: 8px;
}

.command-palette-group-label {
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
}

.command-palette-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 8px;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: background 0.1s ease;
    text-align: left;
}

.command-palette-item:hover,
.command-palette-item.selected {
    background: var(--color-primary-light);
}

[data-theme="dark"] .command-palette-item:hover,
[data-theme="dark"] .command-palette-item.selected {
    background: rgba(59, 130, 246, 0.15);
}

.command-palette-item-icon {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
}

.command-palette-item-icon svg {
    width: 18px;
    height: 18px;
}

.command-palette-item-label {
    flex: 1;
    font-size: 14px;
    color: var(--color-text-main);
}

.command-palette-item-shortcut {
    padding: 3px 6px;
    font-size: 11px;
    font-weight: 500;
    background: var(--color-bg);
    border-radius: 4px;
    color: var(--color-text-muted);
    font-family: inherit;
}

[data-theme="dark"] .command-palette-item-shortcut {
    background: rgba(255, 255, 255, 0.1);
}

.command-palette-empty {
    padding: 40px 20px;
    text-align: center;
    color: var(--color-text-muted);
}

.command-palette-empty p:first-child {
    font-size: 14px;
    color: var(--color-text-main);
    margin-bottom: 8px;
}

.command-palette-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 12px 20px;
    border-top: 1px solid var(--color-border);
    font-size: 12px;
    color: var(--color-text-muted);
}

[data-theme="dark"] .command-palette-footer {
    border-top-color: rgba(255, 255, 255, 0.1);
}

/* Focus Stream Layout - Main container */
.focus-stream-layout {
    display: flex;
    min-height: 100vh;
    background: var(--color-bg);
}

[data-theme="dark"] .focus-stream-layout {
    background: #0A0A0B;
}

/* Focus Mode - Hide sidebar, expand content */
.focus-stream-layout.focus-mode .icon-rail {
    transform: translateX(-100%);
    opacity: 0;
    pointer-events: none;
}

.focus-stream-layout.focus-mode .focus-stream-main {
    margin-left: 0;
}

.focus-stream-layout.focus-mode .focus-stream-content {
    max-width: 100%;
}

.focus-stream-main {
    margin-left: 64px;
    flex: 1;
    display: flex;
    flex-direction: column;
    transition: margin-left 0.25s ease;
}

.focus-stream-layout.nav-expanded .focus-stream-main {
    margin-left: 220px;
}

.focus-stream-header {
    height: 64px;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
}

[data-theme="dark"] .focus-stream-header {
    background: #0A0A0B;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.focus-stream-title {
    display: flex;
    align-items: center;
    gap: 12px;
}

.focus-stream-title h1 {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-main);
}

.focus-stream-title .inbox-count {
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 12px;
}

[data-theme="dark"] .focus-stream-title .inbox-count {
    background: rgba(59, 130, 246, 0.2);
    color: #60A5FA;
}

.focus-stream-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.focus-stream-content {
    flex: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 24px 32px;
    width: 100%;
}

/* Email Stream Groups */
.stream-group {
    margin-bottom: 32px;
}

.stream-group-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    margin-bottom: 8px;
}

.stream-group-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
}

.stream-group-count {
    font-size: 11px;
    color: var(--color-text-light);
}

.stream-group-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
}

[data-theme="dark"] .stream-group-line {
    background: rgba(255, 255, 255, 0.1);
}

/* Stream Email Card */
.stream-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 20px;
    background: var(--color-surface);
    border-radius: 12px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
    border: 1px solid transparent;
}

[data-theme="dark"] .stream-card {
    background: #18181B;
}

.stream-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.1);
}

.stream-card.unread {
    background: var(--color-primary-light);
}

[data-theme="dark"] .stream-card.unread {
    background: rgba(59, 130, 246, 0.1);
}

.stream-card.selected {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
}

.stream-card-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-top: 6px;
    flex-shrink: 0;
}

.stream-card-indicator.unread {
    background: var(--color-primary);
}

.stream-card-content {
    flex: 1;
    min-width: 0;
}

.stream-card-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 4px;
}

.stream-card-sender {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.stream-card-time {
    font-size: 12px;
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-left: auto;
}

.stream-card-subject {
    font-size: 14px;
    color: var(--color-text-main);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.stream-card.unread .stream-card-subject {
    font-weight: 600;
}

.stream-card-preview {
    font-size: 13px;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.stream-card-otp {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 600;
    background: rgba(59, 130, 246, 0.15);
    color: var(--color-primary);
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: background 0.15s ease;
}

.stream-card-otp:hover {
    background: rgba(59, 130, 246, 0.25);
}

[data-theme="dark"] .stream-card-otp {
    background: rgba(59, 130, 246, 0.2);
    color: #60A5FA;
}

/* Empty State */
.stream-empty {
    text-align: center;
    padding: 80px 20px;
    color: var(--color-text-muted);
}

.stream-empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    background: var(--color-primary-light);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
}

[data-theme="dark"] .stream-empty-icon {
    background: rgba(59, 130, 246, 0.15);
}

.stream-empty-icon svg {
    width: 32px !important;
    height: 32px !important;
    max-width: 32px;
    color: var(--color-primary);
}

[data-theme="dark"] .stream-empty-icon svg {
    color: #60A5FA;
}

.stream-empty h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 8px;
}

.stream-empty p {
    font-size: 14px;
    max-width: 320px;
    margin: 0 auto;
}

/* Keyboard shortcut hint */
.shortcut-hint {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: 500;
    background: var(--color-bg);
    border-radius: 4px;
    color: var(--color-text-muted);
}

[data-theme="dark"] .shortcut-hint {
    background: rgba(255, 255, 255, 0.1);
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

/* Detail Overlay - Slide-in panel */
.stream-detail-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 200;
    display: flex;
    justify-content: flex-end;
    animation: fadeIn 0.15s ease;
}

.stream-detail-panel {
    width: 100%;
    max-width: 640px;
    height: 100%;
    background: var(--color-surface);
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    animation: slideInRight 0.25s ease;
}

[data-theme="dark"] .stream-detail-panel {
    background: #18181B;
}

@keyframes slideInRight {
    from {
        opacity: 0;
        transform: translateX(100%);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.stream-detail-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border-bottom: 1px solid var(--color-border);
}

[data-theme="dark"] .stream-detail-header {
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.stream-detail-close {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
}

.stream-detail-close:hover {
    background: var(--color-bg);
    color: var(--color-text-main);
}

[data-theme="dark"] .stream-detail-close:hover {
    background: rgba(255, 255, 255, 0.1);
}

.stream-detail-header h2 {
    flex: 1;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.stream-detail-meta {
    padding: 16px 24px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
}

[data-theme="dark"] .stream-detail-meta {
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.stream-detail-meta strong {
    color: var(--color-text-main);
    font-weight: 500;
}

.stream-detail-body {
    flex: 1;
    padding: 24px;
    overflow-y: auto;
    overscroll-behavior: none;
    touch-action: pan-y;

    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-main);
}

/* Detail Panel Actions */
.stream-detail-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
}

.stream-detail-action {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
}

.stream-detail-action:hover {
    background: var(--color-primary-light);
    color: var(--color-primary);
}

[data-theme="dark"] .stream-detail-action:hover {
    background: rgba(59, 130, 246, 0.15);
    color: #60A5FA;
}

.stream-detail-action--danger:hover {
    background: rgba(239, 68, 68, 0.1);
    color: #EF4444 !important;
}

/* ============================================
   CREATE INBOX MODAL
   ============================================ */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 1000;
    animation: fadeIn 0.15s ease;
}

.create-inbox-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    max-width: 440px;
    background: var(--color-surface);
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    z-index: 1001;
    animation: slideDown 0.2s ease;
    overflow: hidden;
}

[data-theme="dark"] .create-inbox-modal {
    background: #18181B;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.create-inbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--color-border);
}

[data-theme="dark"] .create-inbox-header {
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.create-inbox-header h2 {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-main);
}

.modal-close {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
}

.modal-close:hover {
    background: var(--color-bg);
    color: var(--color-text-main);
}

[data-theme="dark"] .modal-close:hover {
    background: rgba(255, 255, 255, 0.1);
}

.create-inbox-content {
    padding: 24px;
}

.create-inbox-empty {
    text-align: center;
    padding: 24px 0;
}

.create-inbox-empty .empty-icon {
    font-size: 48px;
    margin-bottom: 16px;
    filter: grayscale(0.5);
}

.create-inbox-empty h4 {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 8px;
}

.create-inbox-empty p {
    font-size: 14px;
    color: var(--color-text-muted);
    margin-bottom: 20px;
}

.email-preview {
    background: var(--color-bg);
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 24px;
    text-align: center;
}

[data-theme="dark"] .email-preview {
    background: rgba(255, 255, 255, 0.05);
}

.email-preview-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 6px;
}

.email-preview-value {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-primary);
    font-family: 'JetBrains Mono', monospace;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-main);
    margin-bottom: 8px;
}

.input-with-button {
    display: flex;
    gap: 8px;
}

.form-input {
    flex: 1;
    height: 44px;
    padding: 0 14px;
    font-size: 15px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-bg);
    color: var(--color-text-main);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

[data-theme="dark"] .form-input {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
}

[data-theme="dark"] .form-input:focus {
    border-color: #3B82F6;
}

.form-select {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    font-size: 15px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-bg);
    color: var(--color-text-main);
    cursor: pointer;
    transition: border-color 0.15s ease;
}

.form-select:focus {
    outline: none;
    border-color: var(--color-primary);
}

[data-theme="dark"] .form-select {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
}

.btn-icon {
    width: 44px;
    height: 44px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.create-inbox-footer {
    display: flex;
    gap: 12px;
    padding: 20px 24px;
    border-top: 1px solid var(--color-border);
}

[data-theme="dark"] .create-inbox-footer {
    border-top-color: rgba(255, 255, 255, 0.1);
}

.create-inbox-footer .btn-secondary {
    flex: 1;
    height: 44px;
    padding: 0 20px;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: transparent;
    color: var(--color-text-main);
    cursor: pointer;
    transition: all 0.15s ease;
}

.create-inbox-footer .btn-secondary:hover:not(:disabled) {
    background: var(--color-bg);
}

[data-theme="dark"] .create-inbox-footer .btn-secondary {
    border-color: rgba(255, 255, 255, 0.15);
}

[data-theme="dark"] .create-inbox-footer .btn-secondary:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.05);
}

.create-inbox-footer .btn-primary {
    flex: 1.5;
    height: 44px;
    padding: 0 20px;
    font-size: 14px;
    font-weight: 600;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.15s ease;
}

.create-inbox-footer .btn-primary:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
}

.create-inbox-footer .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* ============================================
   SEARCH BAR - Dedicated email search
   ============================================ */

.search-bar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1000;
    animation: fadeIn 0.15s ease;
}

.search-bar-container {
    position: fixed;
    top: 15%;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 600px;
    background: var(--color-surface);
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    z-index: 1001;
    overflow: hidden;
    animation: slideDown 0.2s ease;
}

[data-theme="dark"] .search-bar-container {
    background: #18181B;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.search-bar-form {
    width: 100%;
}

.search-bar-input-wrapper {
    display: flex;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--color-border);
    gap: 14px;
}

[data-theme="dark"] .search-bar-input-wrapper {
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.search-bar-icon {
    width: 22px;
    height: 22px;
    color: var(--color-primary);
    flex-shrink: 0;
}

.search-bar-input {
    flex: 1;
    font-size: 17px;
    border: none;
    background: transparent;
    color: var(--color-text-main);
    outline: none;
}

.search-bar-input::placeholder {
    color: var(--color-text-muted);
}

.search-bar-clear {
    padding: 6px;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
}

.search-bar-clear:hover {
    background: var(--color-bg);
    color: var(--color-text-main);
}

[data-theme="dark"] .search-bar-clear:hover {
    background: rgba(255, 255, 255, 0.1);
}

.search-bar-kbd {
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 500;
    background: var(--color-bg);
    border-radius: 6px;
    color: var(--color-text-muted);
    font-family: inherit;
}

[data-theme="dark"] .search-bar-kbd {
    background: rgba(255, 255, 255, 0.1);
}

/* Search Hints */
.search-bar-hints {
    padding: 16px 24px;
}

.search-bar-hint-section {
    margin-bottom: 16px;
}

.search-bar-hint-section:last-child {
    margin-bottom: 0;
}

.search-bar-hint-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 10px;
}

.search-bar-hint-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.search-bar-hint-tag {
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 500;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border: none;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.15s ease;
}

.search-bar-hint-tag:hover {
    background: var(--color-primary);
    color: white;
}

[data-theme="dark"] .search-bar-hint-tag {
    background: rgba(59, 130, 246, 0.15);
    color: #60A5FA;
}

[data-theme="dark"] .search-bar-hint-tag:hover {
    background: rgba(59, 130, 246, 0.3);
}

.search-bar-hint-tag--recent {
    background: var(--color-bg);
    color: var(--color-text-main);
}

[data-theme="dark"] .search-bar-hint-tag--recent {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-text-main);
}

.search-bar-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 14px 24px;
    border-top: 1px solid var(--color-border);
    font-size: 12px;
    color: var(--color-text-muted);
    background: var(--color-bg);
}

[data-theme="dark"] .search-bar-footer {
    border-top-color: rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.2);
}

/* ============================================
   ICON RAIL DROPDOWN - Secondary Nav
   ============================================ */

.icon-rail-secondary-container {
    position: relative;
}

.icon-rail-dropdown {
    position: absolute;
    left: 100%;
    top: 0;
    margin-left: 8px;
    min-width: 200px;
    background: var(--color-surface);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    border: 1px solid var(--color-border);
    overflow: hidden;
    animation: slideRight 0.15s ease;
    z-index: 150;
}

[data-theme="dark"] .icon-rail-dropdown {
    background: #18181B;
    border-color: rgba(255, 255, 255, 0.1);
}

@keyframes slideRight {
    from {
        opacity: 0;
        transform: translateX(-8px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.icon-rail-dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: var(--color-text-main);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.15s ease;
}

.icon-rail-dropdown-item:hover {
    background: var(--color-primary-light);
}

[data-theme="dark"] .icon-rail-dropdown-item:hover {
    background: rgba(59, 130, 246, 0.15);
}

.icon-rail-dropdown-item.active {
    background: var(--color-primary-light);
    color: var(--color-primary);
}

[data-theme="dark"] .icon-rail-dropdown-item.active {
    background: rgba(59, 130, 246, 0.2);
    color: #60A5FA;
}

.icon-rail-dropdown-item svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: inherit;
}

/* Mode toggle styling (Focus Mode) */
.icon-rail-item--mode {
    position: relative;
}

.icon-rail-item--mode::after {
    content: '';
    position: absolute;
    bottom: 6px;
    right: 6px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: transparent;
    transition: background 0.15s ease;
}

.icon-rail-item--mode.active::after {
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
}

/* Inline Search */
.inline-search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--color-bg);
    border-radius: 10px;
    border: 1px solid var(--color-border);
    transition: all 0.15s ease;
}

.inline-search:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

[data-theme="dark"] .inline-search {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
}

[data-theme="dark"] .inline-search:focus-within {
    border-color: #60A5FA;
    box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.15);
}

.inline-search-icon {
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
    flex-shrink: 0;
}

.inline-search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 14px;
    color: var(--color-text-main);
    outline: none;
}

.inline-search-input::placeholder {
    color: var(--color-text-muted);
}

/* ============================================
   INBOX TOOLBAR - Quick inbox management
   ============================================ */

.inbox-toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 8px;
}

.inbox-toolbar--empty {
    justify-content: center;
}

/* Inbox Selector */
.inbox-toolbar-selector {
    position: relative;
}

.inbox-toolbar-current {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.15s ease;
    max-width: 320px;
}

.inbox-toolbar-current:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
}

[data-theme="dark"] .inbox-toolbar-current {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
}

[data-theme="dark"] .inbox-toolbar-current:hover {
    background: rgba(59, 130, 246, 0.15);
    border-color: #60A5FA;
}

.inbox-toolbar-icon {
    width: 18px;
    height: 18px;
    color: var(--color-primary);
    flex-shrink: 0;
}

.inbox-toolbar-email {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 220px;
}

.inbox-toolbar-chevron {
    width: 14px;
    height: 14px;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform 0.15s ease;
}

/* Dropdown */
.inbox-toolbar-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 320px;
    max-width: 400px;
    background: var(--color-surface);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    border: 1px solid var(--color-border);
    overflow: hidden;
    z-index: 200;
    animation: slideDown 0.15s ease;
}

[data-theme="dark"] .inbox-toolbar-dropdown {
    background: #18181B;
    border-color: rgba(255, 255, 255, 0.1);
}

.inbox-toolbar-dropdown-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
}

[data-theme="dark"] .inbox-toolbar-dropdown-header {
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.inbox-toolbar-dropdown-count {
    padding: 2px 8px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 10px;
    font-size: 11px;
}

[data-theme="dark"] .inbox-toolbar-dropdown-count {
    background: rgba(59, 130, 246, 0.2);
    color: #60A5FA;
}

.inbox-toolbar-dropdown-list {
    max-height: 280px;
    overflow-y: auto;
    overscroll-behavior: none;
    touch-action: pan-y;

    padding: 8px;
}

.inbox-toolbar-dropdown-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: transparent;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.1s ease;
    text-align: left;
}

.inbox-toolbar-dropdown-item:hover {
    background: var(--color-primary-light);
}

[data-theme="dark"] .inbox-toolbar-dropdown-item:hover {
    background: rgba(59, 130, 246, 0.15);
}

.inbox-toolbar-dropdown-item.active {
    background: var(--color-primary-light);
}

[data-theme="dark"] .inbox-toolbar-dropdown-item.active {
    background: rgba(59, 130, 246, 0.2);
}

.inbox-toolbar-dropdown-email {
    flex: 1;
    font-size: 14px;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.inbox-toolbar-dropdown-copy {
    padding: 6px;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: var(--color-text-muted);
    cursor: pointer;
    opacity: 0;
    transition: all 0.1s ease;
}

.inbox-toolbar-dropdown-item:hover .inbox-toolbar-dropdown-copy {
    opacity: 1;
}

.inbox-toolbar-dropdown-copy:hover {
    background: var(--color-bg);
    color: var(--color-primary);
}

[data-theme="dark"] .inbox-toolbar-dropdown-copy:hover {
    background: rgba(255, 255, 255, 0.1);
}

.inbox-toolbar-dropdown-create {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    margin-top: 8px;
    background: var(--color-primary);
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
}

.inbox-toolbar-dropdown-create:hover {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
}

/* TTL Indicator */
.inbox-toolbar-ttl {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
}

[data-theme="dark"] .inbox-toolbar-ttl {
    background: rgba(59, 130, 246, 0.15);
    color: #60A5FA;
}

.inbox-toolbar-ttl.expired {
    background: rgba(239, 68, 68, 0.1);
    color: #EF4444;
}

/* Action Buttons */
.inbox-toolbar-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
}

.inbox-toolbar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 12px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-main);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
}

.inbox-toolbar-btn svg {
    width: 16px;
    height: 16px;
}

.inbox-toolbar-btn:hover {
    background: var(--color-bg);
    border-color: var(--color-text-muted);
}

[data-theme="dark"] .inbox-toolbar-btn {
    border-color: rgba(255, 255, 255, 0.15);
}

[data-theme="dark"] .inbox-toolbar-btn:hover {
    background: rgba(255, 255, 255, 0.1);
}

/* Copy Button - Primary Style */
.inbox-toolbar-btn--copy {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
}

.inbox-toolbar-btn--copy:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

/* Delete Button */
.inbox-toolbar-btn--delete {
    color: var(--color-text-muted);
}

.inbox-toolbar-btn--delete:hover {
    background: rgba(239, 68, 68, 0.1);
    border-color: #EF4444;
    color: #EF4444;
}

/* Create Button */
.inbox-toolbar-btn--create {
    padding: 8px;
    color: var(--color-primary);
    border-color: var(--color-primary);
}

.inbox-toolbar-btn--create:hover {
    background: var(--color-primary-light);
}

[data-theme="dark"] .inbox-toolbar-btn--create:hover {
    background: rgba(59, 130, 246, 0.15);
}

/* Delete Confirmation */
.inbox-toolbar-delete-container {
    position: relative;
}

.inbox-toolbar-confirm {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    padding: 16px;
    background: var(--color-surface);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    border: 1px solid var(--color-border);
    z-index: 200;
    animation: slideDown 0.15s ease;
    white-space: nowrap;
}

[data-theme="dark"] .inbox-toolbar-confirm {
    background: #18181B;
    border-color: rgba(255, 255, 255, 0.1);
}

.inbox-toolbar-confirm p {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-main);
    margin-bottom: 12px;
}

.inbox-toolbar-confirm-actions {
    display: flex;
    gap: 8px;
}

.inbox-toolbar-confirm-actions button {
    flex: 1;
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-main);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
}

.inbox-toolbar-confirm-actions button:hover {
    background: var(--color-bg);
}

.inbox-toolbar-confirm-actions button.danger {
    background: #EF4444;
    border-color: #EF4444;
    color: white;
}

.inbox-toolbar-confirm-actions button.danger:hover {
    background: #DC2626;
}

/* Create Button for Empty State */
.inbox-toolbar-create {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);
    border: none;
    border-radius: 12px;
    color: white;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
}

.inbox-toolbar-create svg {
    width: 20px;
    height: 20px;
}

.inbox-toolbar-create:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(59, 130, 246, 0.4);
}

/* ============================================
   TAB NAVIGATION
   ============================================ */

.tab-navigation {
    padding: 0 16px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
}

[data-theme="dark"] .tab-navigation {
    background: rgba(255, 255, 255, 0.02);
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.tab-navigation-list {
    display: flex;
    gap: 4px;
}

.tab-navigation-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    color: var(--color-text-muted);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
}

.tab-navigation-item:hover {
    color: var(--color-text-main);
    background: var(--color-primary-light);
}

[data-theme="dark"] .tab-navigation-item:hover {
    background: rgba(59, 130, 246, 0.1);
}

.tab-navigation-item.active {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
}

.tab-navigation-icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.tab-navigation-icon svg {
    width: 18px;
    height: 18px;
}

.tab-navigation-badge {
    padding: 2px 8px;
    background: var(--color-primary);
    color: white;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
}

/* ============================================
   INBOX MANAGER
   ============================================ */

.inbox-manager-header {
    background: var(--color-surface);
}

.inbox-manager-content {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: none;
    touch-action: pan-y;

}

.inbox-manager-list-container {
    display: flex;
    flex-direction: column;
    height: 100%;
}

/* Toolbar */
.inbox-manager-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    flex-wrap: wrap;
    gap: 12px;
}

[data-theme="dark"] .inbox-manager-toolbar {
    background: rgba(255, 255, 255, 0.02);
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.inbox-manager-toolbar-left {
    display: flex;
    align-items: center;
    gap: 16px;
}

.inbox-manager-toolbar-right {
    display: flex;
    align-items: center;
    gap: 10px;
}

.inbox-manager-select-all {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-main);
    cursor: pointer;
}

.inbox-manager-select-all input {
    width: 16px;
    height: 16px;
    cursor: pointer;
}

.inbox-manager-batch-actions {
    display: flex;
    gap: 8px;
}

.inbox-manager-batch-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-main);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
}

.inbox-manager-batch-btn svg {
    width: 14px;
    height: 14px;
}

.inbox-manager-batch-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-light);
}

.inbox-manager-batch-btn--danger:hover {
    border-color: #EF4444;
    color: #EF4444;
    background: rgba(239, 68, 68, 0.1);
}

.inbox-manager-filter,
.inbox-manager-sort {
    padding: 6px 12px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-main);
    font-size: 12px;
    cursor: pointer;
}

[data-theme="dark"] .inbox-manager-filter,
[data-theme="dark"] .inbox-manager-sort {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
}

.inbox-manager-create-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: var(--color-primary);
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
}

.inbox-manager-create-btn svg {
    width: 16px;
    height: 16px;
}

.inbox-manager-create-btn:hover {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
}

/* Inbox List */
.inbox-manager-list {
    flex: 1;
    padding: 16px;
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;

    display: flex;
    flex-direction: column;
    gap: 8px;
}

/* Empty state */
.inbox-manager-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    text-align: center;
    color: var(--color-text-muted);
}

.inbox-manager-empty svg {
    width: 64px;
    height: 64px;
    margin-bottom: 16px;
    opacity: 0.5;
}

.inbox-manager-empty h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 8px;
}

.inbox-manager-empty p {
    margin-bottom: 20px;
}

.inbox-manager-empty button {
    padding: 10px 24px;
    background: var(--color-primary);
    border: none;
    border-radius: 8px;
    color: white;
    font-weight: 600;
    cursor: pointer;
}

/* Footer */
.inbox-manager-footer {
    padding: 12px 16px;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    font-size: 12px;
    color: var(--color-text-muted);
}

/* Messages tab */
.inbox-manager-messages {
    padding: 16px;
}

.inbox-manager-messages-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
}

.inbox-manager-messages-header h2 {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-main);
}

.inbox-manager-messages-count {
    padding: 4px 10px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
}

.inbox-manager-no-inbox {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    text-align: center;
    color: var(--color-text-muted);
}

.inbox-manager-no-inbox svg {
    width: 64px;
    height: 64px;
    margin-bottom: 16px;
    opacity: 0.5;
}

.inbox-manager-no-inbox h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 8px;
}

.inbox-manager-no-inbox button {
    margin-top: 16px;
    padding: 10px 24px;
    background: var(--color-primary);
    border: none;
    border-radius: 8px;
    color: white;
    font-weight: 600;
    cursor: pointer;
}

/* ============================================
   INBOX CARD
   ============================================ */

.inbox-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
}

[data-theme="dark"] .inbox-card {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.1);
}

.inbox-card:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.1);
}

[data-theme="dark"] .inbox-card:hover {
    background: rgba(59, 130, 246, 0.1);
}

.inbox-card.selected {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
}

[data-theme="dark"] .inbox-card.selected {
    background: rgba(59, 130, 246, 0.15);
}

.inbox-card.active {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
}

/* Checkbox */
.inbox-card-checkbox {
    position: relative;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

.inbox-card-checkbox input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
}

.inbox-card-checkbox-custom {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    border-radius: 4px;
    transition: all 0.15s ease;
}

.inbox-card-checkbox input:checked+.inbox-card-checkbox-custom {
    background: var(--color-primary);
    border-color: var(--color-primary);
}

.inbox-card-checkbox input:checked+.inbox-card-checkbox-custom::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 2px;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
}

/* Content */
.inbox-card-content {
    flex: 1;
    min-width: 0;
    /* Crucial for text-overflow to work in flex children */
    overflow: hidden;
    /* Added to ensure no child content spills out */
}

.inbox-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
}

.inbox-card-email {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.inbox-card-status {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
    flex-shrink: 0;
}

.inbox-card-status--active {
    background: rgba(34, 197, 94, 0.1);
    color: #22C55E;
}

.inbox-card-status--expiring {
    background: rgba(245, 158, 11, 0.1);
    color: #F59E0B;
}

.inbox-card-status--expired {
    background: rgba(239, 68, 68, 0.1);
    color: #EF4444;
}

.inbox-card-status--permanent {
    background: var(--color-bg);
    color: var(--color-text-muted);
}

.inbox-card-status-icon {
    font-size: 10px;
}

.inbox-card-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
}

.inbox-card-meta svg {
    width: 14px;
    height: 14px;
    margin-right: 4px;
}

.inbox-card-count,
.inbox-card-domain {
    display: flex;
    align-items: center;
}

/* Actions */
.inbox-card-actions {
    display: flex;
    gap: 4px;
    opacity: 0;
    transition: opacity 0.15s ease;
}

.inbox-card:hover .inbox-card-actions {
    opacity: 1;
}

.inbox-card-action {
    padding: 8px;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
}

.inbox-card-action svg {
    width: 18px;
    height: 18px;
}

.inbox-card-action:hover {
    background: var(--color-bg);
    color: var(--color-text-main);
}

.inbox-card-action--copy:hover {
    color: var(--color-primary);
}

.inbox-card-action--view:hover {
    color: #22C55E;
}

.inbox-card-action--delete:hover {
    background: rgba(239, 68, 68, 0.1);
    color: #EF4444;
}

/* =============================================
   MOBILE RESPONSIVE STYLES
   ============================================= */

/* Mobile: Hide sidebar completely */
@media (max-width: 768px) {
    .icon-rail {
        position: fixed;
        left: -100%;
        width: 240px;
        z-index: 200;
        transition: left 0.3s ease;
        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
    }

    .icon-rail.mobile-open {
        left: 0;
    }

    .focus-stream-main {
        margin-left: 0 !important;
    }

    .focus-stream-header {
        padding: 0 16px;
    }

    .focus-stream-content {
        padding: 16px;
    }

    /* Mobile nav toggle button */
    .mobile-nav-toggle {
        position: fixed;
        bottom: 20px;
        left: 20px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--color-primary);
        color: white;
        border: none;
        cursor: pointer;
        z-index: 150;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 20px rgba(59, 130, 246, 0.4);
    }

    .mobile-nav-toggle svg {
        width: 24px;
        height: 24px;
    }

    /* Mobile overlay */
    .mobile-nav-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 150;
        animation: fadeIn 0.2s ease;
    }

    /* Inbox card mobile optimizations */
    .inbox-card {
        padding: 12px;
    }

    .inbox-card-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }

    .inbox-card-email {
        font-size: 14px;
    }

    .inbox-card-actions {
        opacity: 1;
        position: relative;
    }

    .inbox-card-action {
        min-width: 44px;
        min-height: 44px;
        padding: 10px;
    }

    /* Stream card mobile */
    .stream-card {
        padding: 12px 16px;
    }

    /* Command palette mobile */
    .command-palette {
        top: 10%;
        width: calc(100% - 32px);
        max-width: none;
        margin: 0 16px;
        left: 0;
        transform: none;
    }
}

/* Tablet adjustments */
@media (max-width: 1024px) and (min-width: 769px) {
    .icon-rail {
        width: 56px;
    }

    .icon-rail.expanded {
        width: 200px;
    }

    .focus-stream-main {
        margin-left: 56px;
    }

    .focus-stream-layout.nav-expanded .focus-stream-main {
        margin-left: 200px;
    }

    .focus-stream-content {
        max-width: 100%;
        padding: 20px 24px;
    }
}

/* Mobile List Padding Fix */
@media (max-width: 768px) {
    /* Ensure content is not hidden behind fixed bottom navigation */
    .inbox-manager-list {
        padding-bottom: 80px; 
    }
}
