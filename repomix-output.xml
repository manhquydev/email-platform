/* ====================================
   MOBILE BOTTOM NAVIGATION
   ==================================== */

.mobile-nav-container {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 64px;
  padding: 0 8px;
  padding-bottom: env(safe-area-inset-bottom, 0);
}

.mobile-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  padding: 4px 0;
  color: var(--color-text-muted);
  background: transparent;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  position: relative;
  min-width: 0;
}

.mobile-nav-item.active {
  color: var(--color-primary);
}

.mobile-nav-item.active::after {
  content: '';
  position: absolute;
  bottom: 4px;
  left: 50%;
  transform: translateX(-50%);
  width: 4px;
  height: 4px;
  background: var(--color-primary);
  border-radius: 50%;
}

.mobile-nav-item:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.mobile-nav-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
}

.mobile-nav-icon svg {
  width: 22px;
  height: 22px;
}

.mobile-nav-badge {
  position: absolute;
  top: -4px;
  right: -6px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  background: var(--color-danger);
  color: white;
  font-size: 10px;
  font-weight: 700;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.mobile-nav-label {
  font-size: 10px;
  font-weight: 500;
  margin-top: 2px;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.mobile-nav-compose {
  position: relative;
  margin-top: -20px;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: white;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
  transition: all 0.2s ease;
}

.mobile-nav-compose:active {
  transform: scale(0.92);
  box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
}

.mobile-nav-compose svg {
  width: 22px;
  height: 22px;
}

/* ====================================
   ADMIN COMPACT NAVIGATION (Mobile)
   ==================================== */

@media (max-width: 768px) {

  /* Admin panel mobile layout */
  .admin-layout {
    flex-direction: column !important;
    height: auto !important;
    min-height: 100vh;
  }

  /* Admin sidebar becomes horizontal nav */
  .admin-sidebar {
    width: 100% !important;
    min-height: auto !important;
    flex-direction: row !important;
    border-right: none !important;
    border-bottom: 1px solid var(--color-border) !important;
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
  }

  /* Admin sidebar header - compact on mobile */
  .admin-sidebar>div:first-child {
    display: none;
  }

  /* Admin nav - horizontal scroll */
  .admin-sidebar nav {
    flex: 1;
    padding: 8px 12px !important;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .admin-sidebar nav::-webkit-scrollbar {
    display: none;
  }

  .admin-sidebar nav>div {
    display: flex !important;
    flex-direction: row !important;
    gap: 8px !important;
    width: max-content;
  }

  /* Admin nav buttons - pill style */
  .admin-sidebar nav button {
    flex: 0 0 auto !important;
    padding: 8px 12px !important;
    white-space: nowrap;
    font-size: 12px !important;
    border-radius: 20px !important;
    gap: 6px !important;
  }

  .admin-sidebar nav button svg {
    width: 16px !important;
    height: 16px !important;
  }

  /* Hide button labels on very small screens */
  @media (max-width: 480px) {
    .admin-sidebar nav button {
      padding: 8px 10px !important;
    }

    .admin-sidebar nav button span:last-child {
      display: none;
    }
  }

  /* Admin footer - inline with nav */
  .admin-sidebar>.p-3 {
    padding: 8px !important;
    border-top: none !important;
    border-left: 1px solid var(--color-border);
  }

  .admin-sidebar>.p-3 a {
    padding: 8px 12px !important;
    font-size: 12px !important;
    white-space: nowrap;
  }

  .admin-sidebar>.p-3 a span {
    display: none;
  }
}

/* ====================================
   DASHBOARD MOBILE OPTIMIZATIONS
   ==================================== */

@media (max-width: 768px) {

  /* Category tabs mobile */
  .px-3.pt-2.pb-1.border-b {
    padding: 8px 12px !important;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Message list header spacing */
  .flex-shrink-0 {
    flex-shrink: 0;
  }

  /* Account for bottom nav */
  .pane-layout {
    padding-bottom: 72px;
  }

  /* Sidebar mobile optimizations */
  .h-full.border-r.border-border.bg-surface {
    border-right: none;
    width: 100% !important;
  }

  /* Inbox item mobile touch targets */
  .px-3.py-2.cursor-pointer {
    padding: 12px !important;
  }

  /* Email address truncation */
  .font-medium.text-sm.truncate {
    max-width: 200px;
  }
}

/* Smooth transitions for mobile */
@media (max-width: 768px) {
  * {
    -webkit-tap-highlight-color: transparent;
  }

  button,
  a {
    touch-action: manipulation;
  }
}

/* Scientific/Clean Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background-color: var(--color-border);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background-color: var(--color-text-light);
}

/* =====================================
   QUICK GENERATE CARD STYLES
   ===================================== */

.quick-generate-card {
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-surface) 100%);
  border: 1px solid var(--color-primary-border);
  border-radius: var(--border-radius-lg);
  padding: 1.25rem;
  margin-bottom: 1rem;
  animation: fadeInUp var(--duration-normal) var(--ease-smooth);
}

.quick-generate-card.empty {
  background: var(--color-surface);
  border-color: var(--color-border);
  text-align: center;
  padding: 1.5rem;
}

.quick-generate-icon {
  font-size: 1.25rem;
}

.quick-generate-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.quick-generate-title {
  font-weight: 600;
  color: var(--color-text-main);
  font-size: 0.9rem;
}

.quick-generate-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.domain-selector {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.domain-select {
  flex: 1;
  padding: 0.4rem 0.6rem;
  font-size: 0.85rem;
  border-radius: var(--border-radius-sm);
}

.generate-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.75rem 1rem;
  background: var(--gradient-primary);
  color: white;
  border: none;
  border-radius: var(--border-radius-md);
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-smooth);
  box-shadow: var(--shadow-md);
}

.generate-btn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: var(--shadow-lg);
}

.generate-btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.quick-generate-result {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.generated-email-display {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--color-surface);
  border: 2px solid var(--color-primary);
  border-radius: var(--border-radius-md);
  padding: 0.75rem 1rem;
}

.generated-email {
  flex: 1;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-primary);
  word-break: break-all;
}

.copy-btn {
  padding: 0.5rem;
  background: var(--color-primary-light);
  border: none;
  border-radius: var(--border-radius-sm);
  color: var(--color-primary);
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-smooth);
}

.copy-btn:hover {
  background: var(--color-primary);
  color: white;
}

.copy-btn.copied {
  background: var(--color-success);
  color: white;
}

.regenerate-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.5rem 1rem;
  background: transparent;
  color: var(--color-primary);
  border: 1px solid var(--color-primary-border);
  border-radius: var(--border-radius-md);
  font-weight: 500;
  font-size: 0.875rem;
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-smooth);
}

.regenerate-btn:hover {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

/* Dark mode adjustments */
[data-theme="dark"] .quick-generate-card {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, var(--color-surface) 100%);
}

[data-theme="dark"] .generated-email-display {
  background: var(--color-bg);
}

/* ====================================
   SITE FOOTER STYLES
   ==================================== */


/* ====================================
   PUBLIC LAYOUT STYLES
   ==================================== */

.public-layout {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  overflow-y: auto;
}

.public-main {
  flex: 1;
  padding-top: var(--header-height);
}

/* ====================================
   AUTH LAYOUT STYLES  
   ==================================== */

.auth-layout {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  overflow-y: auto;
  position: relative;
}

.auth-main {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  padding-top: calc(var(--header-height) + 2rem);
  position: relative;
  z-index: 1;
}

.auth-card-wrapper {
  display: flex;
  gap: 2rem;
  max-width: 1000px;
  width: 100%;
  background: var(--color-surface);
  border-radius: var(--border-radius-lg);
  box-shadow: var(--shadow-xl);
  overflow: hidden;
}

@media (max-width: 768px) {
  .auth-card-wrapper {
    flex-direction: column;
    max-width: 450px;
  }

  .auth-decoration {
    display: none;
  }
}

/* ====================================
   LEGAL PAGE CONTENT STYLES
   ==================================== */

.legal-content {
  max-width: 800px;
  margin: 0 auto;
  padding: 3rem 1.5rem 4rem;
}

.legal-content h1 {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.legal-content .legal-updated {
  color: var(--color-text-muted);
  font-size: 0.9rem;
  margin-bottom: 2.5rem;
}

.legal-content section {
  margin-bottom: 2rem;
}

.legal-content h2 {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 0.75rem;
}

.legal-content p {
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 1rem;
}

.legal-content ul {
  color: var(--color-text-secondary);
  padding-left: 1.5rem;
  margin-bottom: 1rem;
}

.legal-content li {
  margin-bottom: 0.5rem;
  line-height: 1.6;
}

.legal-content a {
  color: var(--color-primary);
  text-decoration: none;
}

.legal-content a:hover {
  text-decoration: underline;
}

.legal-nav {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
  display: flex;
  gap: 2rem;
}

.legal-nav a {
  color: var(--color-primary);
  text-decoration: none;
  font-weight: 500;
}

.legal-nav a:hover {
  text-decoration: underline;
}

/* ====================================
   DASHBOARD LAYOUT STYLES
   ==================================== */

.dashboard-with-header {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pane-layout {
  flex: 1;
  display: grid;
  grid-template-columns: 280px minmax(380px, 420px) 1fr;
  height: calc(100vh - var(--header-height));
  overflow: hidden;
}

/* Sidebar Pane */
.pane-layout>div:first-child {
  min-width: 260px;
  max-width: 320px;
}

/* Message List Pane */
.pane-layout>div:nth-child(2) {
  min-width: 350px;
  max-width: 500px;
  border-right: 1px solid var(--color-border);
}

/* Message Detail Pane */
.pane-layout>div:nth-child(3) {
  min-width: 400px;
  flex: 1;
}

/* Responsive: Hide sidebar on small screens */
@media (max-width: 1024px) {
  .pane-layout {
    grid-template-columns: minmax(320px, 400px) 1fr;
  }

  .pane-layout>div:first-child {
    display: none;
  }
}

@media (max-width: 768px) {
  .pane-layout {
    grid-template-columns: 1fr;
  }

  .pane-layout>div:nth-child(2),
  .pane-layout>div:nth-child(3) {
    display: none;
  }
}

/* Email Item Enhancements */
.email-item {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--color-border);
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-smooth);
}

.email-item:hover {
  background-color: var(--color-bg);
}

.email-item.selected {
  background-color: var(--color-primary-light);
  border-left: 3px solid var(--color-primary);
}

.email-item-sender {
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 0.25rem;
}

.email-item-subject {
  font-size: 14px;
  color: var(--color-text-main);
  margin-bottom: 0.25rem;
}

.email-item-preview {
  font-size: 13px;
  color: var(--color-text-muted);
  line-height: 1.5;
}

/* Action buttons overlay */
.email-item-actions {
  position: absolute;
  right: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0;
  transition: opacity var(--duration-fast) var(--ease-smooth);
  background: var(--color-surface);
  padding: 0.25rem;
  border-radius: var(--border-radius-md);
  box-shadow: var(--shadow-md);
  border: 1px solid var(--color-border);
}

.email-item:hover .email-item-actions {
  opacity: 1;
}

/* ====================================
   SITE NAVIGATION (Public)
   ==================================== */
.site-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-border);
  transition: all 0.3s ease;
}

[data-theme="dark"] .site-nav {
  background: rgba(10, 10, 11, 0.7);
}

.site-nav-auth {
  background: transparent;
  border-bottom: none;
}

.site-nav-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.site-nav-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: var(--color-text-main);
}

.site-nav-logo-icon {
  width: 36px;
  height: 36px;
  background: var(--gradient-primary);
  border-radius: var(--border-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.site-nav-logo-text {
  font-size: 1.25rem;
  font-weight: 700;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.site-nav-links {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.site-nav-link {
  color: var(--color-text-muted);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 500;
  transition: color var(--duration-fast) var(--ease-smooth);
}

.site-nav-link:hover {
  color: var(--color-primary);
}

.btn-nav-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.25rem;
  background: var(--gradient-primary);
  color: white;
  border: none;
  border-radius: var(--border-radius-full);
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-smooth);
  box-shadow: var(--shadow-md);
}

.btn-nav-primary:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-lg), var(--shadow-glow);
}

/* Mobile Hamburger */
.site-nav-hamburger {
  display: none;
  background: transparent;
  border: none;
  color: var(--color-text-main);
  cursor: pointer;
  padding: 0.5rem;
}

/* Mobile Menu */
.site-nav-mobile {
  position: fixed;
  top: 0;
  right: 0;
  width: 280px;
  height: 100vh;
  background: var(--color-surface);
  box-shadow: -10px 0 30px rgba(0, 0, 0, 0.2);
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 102;
  padding: 6rem 1.5rem 2rem;
  border-left: 1px solid var(--color-border);
}

.site-nav-mobile.open {
  transform: translateX(0);
}

.site-nav-mobile-links {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.site-nav-mobile-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--color-text-main);
  text-decoration: none;
}

.site-nav-mobile-divider {
  height: 1px;
  background: var(--color-border);
  margin: 0.5rem 0;
}

.site-nav-mobile-cta {
  justify-content: center;
  padding: 0.75rem;
  background: var(--gradient-primary);
  color: white;
  border-radius: var(--border-radius-lg);
}

.site-nav-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 101;
  animation: fadeIn 0.2s ease-out;
}

@media (max-width: 768px) {
  .site-nav-links {
    display: none;
  }

  .site-nav-hamburger {
    display: block;
  }
}

/* ====================================
   MOBILE OPTIMIZATION (Nebula Glass)
   ==================================== */

.mobile-nav-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 64px;
  max-width: 600px;
  margin: 0 auto;
  padding: 0 1rem;
}

.mobile-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  color: var(--color-text-muted);
  font-size: 0.7rem;
  font-weight: 500;
  transition: all var(--duration-fast) var(--ease-smooth);
}

.mobile-nav-item.active {
  color: var(--color-primary);
}

.mobile-nav-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mobile-nav-badge {
  position: absolute;
  top: -4px;
  right: -8px;
  background: var(--color-danger);
  color: white;
  font-size: 10px;
  font-weight: 700;
  padding: 2px 5px;
  border-radius: 999px;
  border: 2px solid var(--color-surface);
  line-height: 1;
}

.mobile-nav-compose {
  width: 48px;
  height: 48px;
  background: var(--gradient-primary);
  color: white;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg), var(--shadow-glow);
  transform: translateY(-12px);
  transition: all var(--duration-fast) var(--ease-smooth);
}

.mobile-nav-compose:active {
  transform: translateY(-12px) scale(0.92);
}

.mobile-nav-label {
  font-size: 10px;
  letter-spacing: 0.02em;
}

/* Safe areas for mobile */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom, 0);
}

.safe-area-top {
  padding-top: env(safe-area-inset-top, 0);
}

/* Layout adjustments for mobile nav */
@media (max-width: 768px) {

  .focus-stream-main,
  .modern-dashboard,
  .app-content {
    padding-bottom: 72px;
    /* Space for bottom nav */
  }
}

/* Skeleton Loaders */
.skeleton-base {
  background: rgba(255, 255, 255, 0.05);
  background: linear-gradient(90deg,
      rgba(255, 255, 255, 0.05) 25%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.05) 75%);
  background-size: 200% 100%;
  animation: shimmer 2s infinite linear;
}

.inbox-card-skeleton {
  padding: 1rem;
  background: var(--neo-glass-bg);
  backdrop-filter: blur(var(--neo-glass-blur));
  border: 1px solid var(--neo-glass-border);
  border-radius: var(--radius-xl);
  margin-bottom: 1rem;
}

.message-item-skeleton {
  background: rgba(255, 255, 255, 0.02);
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}

/* =========================================
   AUTH LAYOUT SPECIFIC STYLES
   ========================================= */
.auth-layout {
  position: relative;
  min-height: 100vh;
  width: 100vw;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--nebula-void);
  color: var(--nebula-text);
}

.auth-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.auth-bg-gradient {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 15% 50%, rgba(76, 29, 149, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 85% 30%, rgba(6, 182, 212, 0.1) 0%, transparent 60%);
  backdrop-filter: blur(64px);
  -webkit-backdrop-filter: blur(64px);
}

.auth-bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 50px 50px;
  mask-image: radial-gradient(circle at center, black 40%, transparent 100%);
  opacity: 0.5;
}

.auth-bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.4;
  animation: float 10s ease-in-out infinite;
}

.auth-bg-glow-1 {
  top: -10%;
  left: -10%;
  width: 40vw;
  height: 40vw;
  background: var(--nebula-violet-light);
  animation-delay: 0s;
}

.auth-bg-glow-2 {
  bottom: -10%;
  right: -10%;
  width: 35vw;
  height: 35vw;
  background: var(--nebula-cyan);
  animation-delay: -5s;
}

.auth-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 10;
  width: 100%;
  padding: 2rem;
}

/* Auth Card Specifics - for wrapping forms */
.auth-card-container {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 420px;
  margin: auto;
  padding: 2rem;
}

.landing-nav-auth {
  background: transparent !important;
  backdrop-filter: none !important;
  border-bottom: none !important;
}

/* ====================================
   EMAIL CONTENT STYLES (Light/Dark Mode)
   ==================================== */

/* Base email content styles */
.email-content {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 0.95rem;
  line-height: 1.7;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

/* Light mode email content */
.email-content {
  color: var(--color-text-main, #1e293b);
  background-color: transparent;
}

.email-content a {
  color: var(--color-primary, #3b82f6);
  text-decoration: underline;
}

.email-content a:hover {
  color: var(--color-primary-hover, #2563eb);
}

.email-content img {
  max-width: 100%;
  height: auto;
  border-radius: var(--border-radius-sm, 6px);
}

.email-content table {
  border-collapse: collapse;
  width: 100%;
  margin: 1rem 0;
}

.email-content th,
.email-content td {
  border: 1px solid var(--color-border, #e2e8f0);
  padding: 0.5rem 0.75rem;
  text-align: left;
}

.email-content th {
  background-color: var(--color-bg, #f8fafc);
  font-weight: 600;
}

.email-content blockquote {
  border-left: 4px solid var(--color-primary-border, #93c5fd);
  margin: 1rem 0;
  padding: 0.5rem 1rem;
  background-color: var(--color-primary-light, #eff6ff);
  color: var(--color-text-secondary, #475569);
  border-radius: 0 var(--border-radius-sm, 6px) var(--border-radius-sm, 6px) 0;
}

.email-content pre,
.email-content code {
  font-family: 'JetBrains Mono', 'Fira Code', Consolas, Monaco, monospace;
  font-size: 0.875rem;
  background-color: var(--color-bg, #f1f5f9);
  border-radius: var(--border-radius-sm, 6px);
}

.email-content pre {
  padding: 1rem;
  overflow-x: auto;
  border: 1px solid var(--color-border, #e2e8f0);
}

.email-content code {
  padding: 0.125rem 0.375rem;
}

.email-content hr {
  border: none;
  border-top: 1px solid var(--color-border, #e2e8f0);
  margin: 1.5rem 0;
}

.email-content h1,
.email-content h2,
.email-content h3,
.email-content h4,
.email-content h5,
.email-content h6 {
  color: var(--color-text-main, #0f172a);
  font-weight: 600;
  margin: 1.5rem 0 0.75rem;
  line-height: 1.3;
}

.email-content p {
  margin: 0.75rem 0;
}

.email-content ul,
.email-content ol {
  margin: 0.75rem 0;
  padding-left: 1.5rem;
}

.email-content li {
  margin: 0.25rem 0;
}

/* Dark mode email content */
[data-theme="dark"] .email-content,
.dark .email-content {
  color: var(--nebula-text, #f1f5f9);
}

[data-theme="dark"] .email-content a,
.dark .email-content a {
  color: var(--nebula-violet-light, #a78bfa);
}

[data-theme="dark"] .email-content a:hover,
.dark .email-content a:hover {
  color: var(--nebula-cyan, #22d3ee);
}

[data-theme="dark"] .email-content th,
[data-theme="dark"] .email-content td,
.dark .email-content th,
.dark .email-content td {
  border-color: var(--nebula-border, rgba(255, 255, 255, 0.08));
}

[data-theme="dark"] .email-content th,
.dark .email-content th {
  background-color: var(--nebula-surface, #12182b);
}

[data-theme="dark"] .email-content blockquote,
.dark .email-content blockquote {
  border-left-color: var(--nebula-violet, #8b5cf6);
  background-color: rgba(139, 92, 246, 0.1);
  color: var(--nebula-text-secondary, #94a3b8);
}

[data-theme="dark"] .email-content pre,
[data-theme="dark"] .email-content code,
.dark .email-content pre,
.dark .email-content code {
  background-color: var(--nebula-elevated, #1a2340);
  color: var(--nebula-text, #f1f5f9);
}

[data-theme="dark"] .email-content pre,
.dark .email-content pre {
  border-color: var(--nebula-border, rgba(255, 255, 255, 0.08));
}

[data-theme="dark"] .email-content hr,
.dark .email-content hr {
