generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DomainStatus {
  PENDING
  VERIFIED
}

enum UserRole {
  ADMIN
  USER
}

enum RuleType {
  ALLOW
  BLOCK
}

enum RuleScope {
  SENDER_DOMAIN
  SENDER_EMAIL
  RECIPIENT_DOMAIN
  RECIPIENT_INBOX
  SOURCE_IP
}

enum AbuseReportStatus {
  OPEN
  REVIEWING
  CLOSED
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  emailVerified DateTime?
  verificationToken String?
  verificationTokenExpiresAt DateTime?
  isDisabled   Boolean  @default(false)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?  // encrypted TOTP secret
  twoFactorBackupCodes String[] // array of hashed backup codes
  // Subscription fields
  tier         SubscriptionTier @default(FREE)
  stripeCustomerId String? @unique
  stripeSubscriptionId String?
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  trialEndsAt  DateTime?
  createdAt    DateTime @default(now())
  auditLogs    AuditLog[]
  domains      Domain[]
}

model Domain {
  id                 String        @id @default(uuid())
  name               String        @unique
  status             DomainStatus  @default(PENDING)
  verificationToken  String
  createdAt          DateTime      @default(now())
  inboxes            Inbox[]
  owner              User?         @relation(fields: [ownerId], references: [id])
  ownerId            String?
  isPublic           Boolean       @default(false)
}

model Inbox {
  id             String        @id @default(uuid())
  domain         Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId       String
  localPart      String
  createdAt      DateTime      @default(now())
  expiresAt      DateTime?
  flags          Json?
  deletedAt      DateTime?
  messages       Message[]
  emailFilters   EmailFilter[]
  labels         Label[]

  @@unique([domainId, localPart])
}

model Message {
  id           String         @id @default(uuid())
  inbox        Inbox          @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  inboxId      String
  messageId    String?
  fromAddress  String?
  toAddress    String?
  subject      String?
  receivedAt   DateTime       @default(now())
  textBody     String?
  htmlBody     String?
  sourceIp     String?
  headers      Json?
  spamScore    Float?
  size         Int?
  deletedAt    DateTime?
  isRead       Boolean        @default(false)
  isPinned     Boolean        @default(false)
  snoozedUntil DateTime?
  attachments  Attachment[]
  abuseReports AbuseReport[]
  labels       MessageLabel[]

  @@index([inboxId, receivedAt])
  @@index([sourceIp, receivedAt])
  @@index([deletedAt])
  @@index([isPinned])
}

model Attachment {
  id          String   @id @default(uuid())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId   String
  filename    String
  mimeType    String?
  size        Int?
  storageKey  String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

model Rule {
  id        String    @id @default(uuid())
  type      RuleType
  scope     RuleScope
  value     String
  note      String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([scope, value])
}

model AbuseReport {
  id         String            @id @default(uuid())
  message    Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageId  String?
  reporter   String?
  reason     String
  status     AbuseReportStatus @default(OPEN)
  createdAt  DateTime          @default(now())

  @@index([status])
  @@index([messageId])
}

// Email Filter/Rule for automated message processing
enum FilterMatchType {
  ALL     // All conditions must match
  ANY     // Any condition must match
}

enum FilterConditionField {
  FROM
  TO
  SUBJECT
  BODY
  HAS_ATTACHMENT
}

enum FilterConditionOperator {
  CONTAINS
  NOT_CONTAINS
  EQUALS
  NOT_EQUALS
  STARTS_WITH
  ENDS_WITH
  REGEX
}

enum FilterActionType {
  MOVE_TO_FOLDER
  ADD_LABEL
  REMOVE_LABEL
  MARK_READ
  MARK_SPAM
  DELETE
  FORWARD
}

model EmailFilter {
  id          String          @id @default(uuid())
  inbox       Inbox           @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  inboxId     String
  name        String
  description String?
  matchType   FilterMatchType @default(ALL)
  conditions  Json            // Array of { field, operator, value }
  actions     Json            // Array of { type, value? }
  priority    Int             @default(0)
  isEnabled   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([inboxId, isEnabled])
}

// Labels for organizing messages
model Label {
  id        String         @id @default(uuid())
  inbox     Inbox          @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  inboxId   String
  name      String
  color     String?        // Hex color code
  parentId  String?        // For nested labels/folders
  parent    Label?         @relation("LabelHierarchy", fields: [parentId], references: [id])
  children  Label[]        @relation("LabelHierarchy")
  messages  MessageLabel[]
  createdAt DateTime       @default(now())

  @@unique([inboxId, name])
  @@index([inboxId])
}

model MessageLabel {
  id        String   @id @default(uuid())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId   String
  createdAt DateTime @default(now())

  @@unique([messageId, labelId])
  @@index([messageId])
  @@index([labelId])
}
