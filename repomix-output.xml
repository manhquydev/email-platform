kind: Service
metadata:
  name: api-service
  labels:
    app: tempmail
    component: api
spec:
  selector:
    app: tempmail
    component: api
  ports:
    - name: http
      port: 3001
      targetPort: 3001
    - name: smtp
      port: 2525
      targetPort: 2525
  type: ClusterIP
