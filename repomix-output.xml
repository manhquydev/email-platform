/* CTA - The Cosmic Gateway (v2) */
.landing-cta-gateway {
    position: relative;
    z-index: 10;
    padding: 140px var(--nebula-space-lg);
    background: radial-gradient(circle at center, rgba(30, 20, 50, 0.6) 0%, var(--nebula-bg) 70%);
    overflow: hidden;
