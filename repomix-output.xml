<file path="services/web/src/styles/touch-targets.css">
/* Mobile Touch Targets - WCAG 2.1 compliant (44px minimum) */

/* Base touch target class */
.touch-target {
  min-height: 44px;
  min-width: 44px;
}

.touch-target-sm {
  min-height: 36px;
  min-width: 36px;
}

/* Apply to common interactive elements on mobile */
@media (max-width: 768px) {
  /* Buttons */
  button:not(.touch-exempt),
  [role="button"]:not(.touch-exempt) {
    min-height: 44px;
    min-width: 44px;
  }

  /* Links that look like buttons */
  a.btn,
  a[class*="button"] {
    min-height: 44px;
    min-width: 44px;
  }

  /* Form inputs */
  input[type="checkbox"],
  input[type="radio"] {
    min-height: 24px;
    min-width: 24px;
  }

  /* Icon buttons - ensure clickable area */
  .icon-btn,
  button[aria-label]:not(.touch-exempt) {
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* List items that are clickable */
  li[role="option"],
  [role="menuitem"] {
    min-height: 44px;
    padding-top: 10px;
    padding-bottom: 10px;
  }
}

/* Utility to exempt small inline elements */
.touch-exempt {
  min-height: auto !important;
  min-width: auto !important;
}
