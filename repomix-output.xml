/* ============================================
   INTERACTIVE CURSOR STATES
   Classes for proper cursor feedback
   ============================================ */

/* Interactive Card - Clickable cards with hover effects */
.interactive-card {
  cursor: pointer;
  transition: all var(--duration-normal, 250ms) var(--ease-smooth, cubic-bezier(0.4, 0, 0.2, 1));
}

.interactive-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-lg);
}

.interactive-card:active {
  transform: translateY(0);
  box-shadow: var(--shadow-md);
}

/* Interactive List Item - For list-based navigation */
.interactive-list-item {
  cursor: pointer;
  transition: background-color var(--duration-fast, 150ms) var(--ease-smooth);
}

.interactive-list-item:hover {
  background-color: var(--color-primary-light, rgba(99, 102, 241, 0.08));
}

.interactive-list-item:active {
  background-color: var(--color-primary-light, rgba(99, 102, 241, 0.12));
}

/* Interactive Button - Enhanced button states */
.interactive-btn {
  cursor: pointer;
  transition: all var(--duration-fast, 150ms) var(--ease-smooth);
}

.interactive-btn:hover:not(:disabled) {
  transform: translateY(-1px);
}

.interactive-btn:active:not(:disabled) {
  transform: translateY(0);
}

.interactive-btn:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

/* Interactive Link - Text links with underline animation */
.interactive-link {
  cursor: pointer;
  position: relative;
  text-decoration: none;
  color: var(--color-primary);
  transition: color var(--duration-fast, 150ms) var(--ease-smooth);
}

.interactive-link::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 2px;
  background: currentColor;
  transition: width var(--duration-fast, 150ms) var(--ease-smooth);
}

.interactive-link:hover::after {
  width: 100%;
}

/* Interactive Icon Button - For icon-only buttons */
.interactive-icon-btn {
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-button);
  transition: all var(--duration-fast, 150ms) var(--ease-smooth);
}

.interactive-icon-btn:hover:not(:disabled) {
  background-color: var(--color-primary-light, rgba(99, 102, 241, 0.1));
  color: var(--color-primary);
}

.interactive-icon-btn:active:not(:disabled) {
  transform: scale(0.95);
}

/* Draggable - Items that can be dragged */
.draggable {
  cursor: grab;
}

.draggable:active {
  cursor: grabbing;
}

/* Resizable - Items that can be resized */
.resizable {
  cursor: nwse-resize;
}

/* Wait State - Loading or processing */
.cursor-wait {
  cursor: wait;
}

/* Help State - Additional information available */
.cursor-help {
  cursor: help;
}

/* Text Selection */
.selectable-text {
  cursor: text;
  user-select: text;
}

.non-selectable {
  cursor: default;
  user-select: none;
}

/* Zoom States */
.cursor-zoom-in {
  cursor: zoom-in;
}

.cursor-zoom-out {
  cursor: zoom-out;
}

/* ============================================
   FOCUS VISIBLE STATES
   Enhanced focus indicators for accessibility
   ============================================ */

.focus-ring:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
  box-shadow: 0 0 0 2px var(--color-surface), 0 0 0 4px var(--color-primary);
}

.focus-ring-inset:focus-visible {
  outline: none;
  box-shadow: inset 0 0 0 2px var(--color-primary);
}

/* ============================================
   RESPONSIVE TYPOGRAPHY
   ============================================ */

@media (max-width: 768px) {
