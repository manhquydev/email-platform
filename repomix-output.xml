                        {/* Email Body */}
                        <GlassCard className="p-6 md:p-8 rounded-2xl bg-nebula-surface border-2 border-nebula-border overflow-hidden shadow-sm">
                            {message.htmlBody ? (
                                <div className="prose dark:prose-invert max-w-none">
