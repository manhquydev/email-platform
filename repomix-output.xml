      labels:
        app: tempmail
        component: api
    spec:
      containers:
        - name: api
          image: tempmail-api:latest
          ports:
            - containerPort: 3001
              name: http
            - containerPort: 2525
              name: smtp
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: tempmail-secrets
                  key: database-url
            - name: DATABASE_READ_URL
              valueFrom:
                secretKeyRef:
                  name: tempmail-secrets
                  key: database-read-url
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: tempmail-secrets
                  key: jwt-secret
            - name: REDIS_HOST
              value: redis-service
