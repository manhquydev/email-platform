                    />
                </svg>
                <span className="text-sm font-medium text-text-main">
                    Mã xác thực
                </span>
                {otp.confidence === 'high' && (
                    <span className="text-[10px] px-1.5 py-0.5 rounded bg-green-500/20 text-green-400 font-medium">
                        Độ tin cậy cao
                    </span>
                )}
            </div>

            {/* OTP Code Display */}
            <button
                onClick={handleCopy}
