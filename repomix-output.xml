                    <Route path="/forwarding" element={<Forwarding />} />
                    <Route path="/teams" element={<Teams />} />
                    <Route path="/plans" element={<Plans />} />
                  </Route>

                  {/* Fallback */}
                  <Route path="*" element={<Navigate to="/" replace />} />
                </Routes>
              </Suspense>
            </ErrorBoundary>
          </BrowserRouter>
        </RealtimeProvider>
      </AuthProvider>
    </ThemeProvider>
  );
}

export default App;
