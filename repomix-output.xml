    margin: 0 auto;
    padding: 100px 40px;
    border-radius: 40px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(10, 5, 20, 0.6);
    backdrop-filter: blur(24px);
    box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.05),
        0 40px 120px rgba(0, 0, 0, 0.5),
        inset 0 0 60px rgba(139, 92, 246, 0.05);
    /* Inner subtle glow */
}

/* The Portal Glow - Background Effect */
.portal-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.25) 0%, transparent 60%);
    opacity: 0.6;
    pointer-events: none;
    z-index: -1;
    animation: portalPulse 8s ease-in-out infinite alternate;
}

@keyframes portalPulse {
    0% {
        opacity: 0.4;
        transform: translate(-50%, -50%) scale(0.95);
    }

    100% {
        opacity: 0.7;
        transform: translate(-50%, -50%) scale(1.05);
    }
}

/* Cyber Artifact - The Centerpiece */
.cyber-artifact-container {
    display: flex;
    justify-content: center;
    margin-bottom: 50px;
    perspective: 1000px;
}

.cyber-artifact {
    position: relative;
    width: 320px;
    height: 64px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.2),
        inset 0 0 20px rgba(139, 92, 246, 0.1);
    transform-style: preserve-3d;
}

.artifact-core {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--nebula-violet);
}

.artifact-icon svg {
    width: 24px;
    height: 24px;
    filter: drop-shadow(0 0 8px rgba(139, 92, 246, 0.6));
}

.artifact-text {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 1.1rem;
    color: #fff;
    text-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
    letter-spacing: 0.05em;
}

/* Orbiting Animation */
.orbit-ring {
    position: absolute;
    width: 360px;
    height: 120px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotateX(75deg);
    pointer-events: none;
    animation: rotateRing 20s linear infinite;
}

.orbit-object {
    position: absolute;
    top: 50%;
    width: 36px;
    height: 36px;
    margin-top: -18px;
    margin-left: -18px;
    background: var(--nebula-surface);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--nebula-violet-light);
    box-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
    animation: counterRotate 20s linear infinite;
    /* Keeps icon upright */
}

.orbit-object.shield {
    left: 100%;
}

.orbit-object.key {
    left: 0%;
}

.orbit-object svg {
    width: 18px;
    height: 18px;
}

@keyframes rotateRing {
    0% {
        transform: translate(-50%, -50%) rotateX(75deg) rotate(0deg);
    }

    100% {
        transform: translate(-50%, -50%) rotateX(75deg) rotate(360deg);
    }
}

@keyframes counterRotate {
    0% {
        transform: rotate(0deg) rotateX(-75deg) scale(1.5);
    }

    /* Scale simulates depth */
    25% {
        transform: rotate(-90deg) rotateX(-75deg) scale(0.8);
    }

    50% {
        transform: rotate(-180deg) rotateX(-75deg) scale(0.6);
    }

    75% {
        transform: rotate(-270deg) rotateX(-75deg) scale(0.8);
    }

    100% {
        transform: rotate(-360deg) rotateX(-75deg) scale(1.5);
    }
}

/* Typography & Actions */
.portal-title {
