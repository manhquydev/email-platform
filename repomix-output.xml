<file path="services/postfix/opendkim.conf">
# OpenDKIM Configuration
# ======================

# Log settings
Syslog                  yes
SyslogSuccess           yes
LogWhy                  yes

# Canonicalization algorithm
Canonicalization        relaxed/simple

# DKIM Mode - sign only, don't verify
Mode                    s

# Selector - matches DNS record
Selector                mail

# SubDomains - sign subdomains too
SubDomains              no

# External hosts can use this for signing
ExternalIgnoreList      /etc/opendkim/TrustedHosts
InternalHosts           /etc/opendkim/TrustedHosts

# Key table
KeyTable                /etc/opendkim/KeyTable
SigningTable            refile:/etc/opendkim/SigningTable

# Socket for Postfix
Socket                  local:/var/spool/postfix/opendkim/opendkim.sock

# Permissions - use Umask 000 for world-accessible socket
Umask                   000
UserID                  opendkim:opendkim

# PID file
PidFile                 /run/opendkim/opendkim.pid

# Algorithm
SignatureAlgorithm      rsa-sha256

# Don't oversign headers
OversignHeaders         From

# Auto restart
AutoRestart             yes
AutoRestartRate         10/1M
</file>

