    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
  }

  .h-screen.flex.bg-bg>.w-60 nav button svg {
    width: 1rem;
    height: 1rem;
  }

  /* Admin content area */
  .h-screen.flex.bg-bg>.flex-1 {
