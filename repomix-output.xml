                    )}
                    {/* Collapse indicator */}
                    <motion.span
                        className={cn(
                            "material-symbols-outlined text-nebula-text-muted ml-auto transition-transform duration-300",
                            isCollapsed ? "rotate-180" : ""
                        )}
                        style={{ display: isCollapsed ? "none" : "block" }}
