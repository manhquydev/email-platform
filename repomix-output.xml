FROM alpine:3.18

# Install Dovecot and dependencies
# dovecot-pcre is likely included or not available as separate package
# Added dovecot-sql as we use dovecot-sql.conf.ext
RUN apk add --no-cache \
    dovecot \
    dovecot-lmtpd \
    dovecot-pop3d \
    dovecot-submissiond \
    dovecot-sql \
    openssl \
    bash

# Generate self-signed certificate for Dovecot
RUN mkdir -p /etc/ssl/certs /etc/ssl/private && \
    openssl req -new -x509 -days 365 -nodes \
    -out /etc/ssl/certs/dovecot.pem \
    -keyout /etc/ssl/private/dovecot.pem \
    -subj "/C=US/ST=Denial/L=Springfield/O=Dis/CN=localhost" && \
    chmod 0600 /etc/ssl/private/dovecot.pem

# Generate DH parameters for SSL (required by 10-ssl.conf)
RUN openssl dhparam -out /etc/dovecot/dh.pem 2048

# Copy configuration files
COPY dovecot.conf /etc/dovecot/dovecot.conf
COPY conf.d/ /etc/dovecot/conf.d/
COPY dovecot-sql.conf.ext /etc/dovecot/dovecot-sql.conf.ext

# Create mail directory and set permissions
RUN mkdir -p /var/mail && \
    chown -R dovecot:dovecot /var/mail && \
    chmod 755 /var/mail

# Expose IMAP ports
EXPOSE 143 993

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD doveadm service status || exit 1

# Start Dovecot in foreground
CMD ["dovecot", "-F"]
</file>

<file path="services/dovecot/dovecot-sql.conf.ext">
# Dovecot SQL authentication configuration
# This connects to the same PostgreSQL database as the API

driver = pgsql
connect = host=postgres dbname=email_service user=postgres password=%{env:POSTGRES_PASSWORD}

# Password query - authenticate user by inbox address
# Format: localpart@domain
password_query = \
  SELECT i."localPart" || '@' || d.name AS user, \
         u."passwordHash" AS password, \
         '/var/mail/' || d.name || '/' || i."localPart" AS userdb_home, \
         'maildir:/var/mail/' || d.name || '/' || i."localPart" AS userdb_mail \
  FROM "Inbox" i \
  JOIN "Domain" d ON i."domainId" = d.id \
  JOIN "User" u ON d."ownerId" = u.id \
  WHERE i."localPart" || '@' || d.name = '%u' \
    AND i."deletedAt" IS NULL \
    AND d.status = 'VERIFIED' \
    AND u."isDisabled" = false

# User query - get mailbox location
user_query = \
  SELECT i."localPart" || '@' || d.name AS user, \
         '/var/mail/' || d.name || '/' || i."localPart" AS home, \
         'maildir:/var/mail/' || d.name || '/' || i."localPart" AS mail \
  FROM "Inbox" i \
  JOIN "Domain" d ON i."domainId" = d.id \
  WHERE i."localPart" || '@' || d.name = '%u' \
    AND i."deletedAt" IS NULL

# Iteration query - list all users
iterate_query = \
  SELECT i."localPart" || '@' || d.name AS user \
  FROM "Inbox" i \
  JOIN "Domain" d ON i."domainId" = d.id \
  WHERE i."deletedAt" IS NULL \
    AND d.status = 'VERIFIED'

# Default password scheme (bcrypt)
default_pass_scheme = BLF-CRYPT
</file>

<file path="services/dovecot/dovecot.conf">
# Dovecot main configuration
protocols = imap lmtp

# Logging
log_path = /dev/stderr
info_log_path = /dev/stdout
debug_log_path = /dev/stdout

# Security
ssl = required
ssl_cert = </etc/ssl/certs/dovecot.pem
ssl_key = </etc/ssl/private/dovecot.pem
ssl_min_protocol = TLSv1.2

# Mail location using Maildir format
mail_location = maildir:/var/mail/%d/%n

# Authentication
auth_mechanisms = plain login
disable_plaintext_auth = no

# Include configuration directory
!include conf.d/*.conf
</file>

