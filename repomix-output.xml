#root {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 3rem;
}

.shell {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);
  overflow: hidden;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 1.75rem;
  background: linear-gradient(135deg, #0f172a, #1d2b50);
  color: #f8fafc;
}

.header .title {
  display: flex;
  gap: 0.9rem;
  align-items: center;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.pill {
  display: inline-flex;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.12);
  color: #e2e8f0;
}

.content {
  display: grid;
  gap: 1.25rem;
  padding: 1.75rem;
  grid-template-columns: 1.4fr 1fr;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.panel {
  background: #fbfdff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 1.1rem 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.panel h2 {
  margin: 0;
  font-size: 1.05rem;
  letter-spacing: -0.01em;
}

.muted {
  color: #475569;
  font-size: 0.95rem;
}

.grid-two {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
}

.row {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.item {
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 0.75rem 0.85rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  transition: border-color 120ms ease, box-shadow 120ms ease;
}

.item:hover {
  border-color: #94a3b8;
  box-shadow: 0 10px 20px rgba(15, 23, 42, 0.06);
}

.badge {
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 700;
  border: 1px solid #cbd5e1;
  background: #f8fafc;
  color: #0b172a;
}

.label {
  font-size: 0.85rem;
  font-weight: 700;
  color: #0b172a;
}

.small {
  font-size: 0.85rem;
  color: #475569;
}

.actions {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.danger {
  color: #dc2626;
}

.message-body {
  border: 1px dashed #cbd5e1;
  border-radius: 10px;
  padding: 0.9rem;
  background: #ffffff;
  min-height: 120px;
  white-space: pre-wrap;
}

.split {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 1rem;
}

.footer {
  padding: 1rem 1.75rem 1.35rem;
  border-top: 1px solid #e2e8f0;
  color: #475569;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.9rem;
}

.link {
  color: #2563eb;
  text-decoration: underline;
}

@media (max-width: 960px) {
  .content {
    grid-template-columns: 1fr;
  }

  .split {
    grid-template-columns: 1fr;
  }
}
