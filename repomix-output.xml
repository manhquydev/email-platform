# Log settings
Syslog                  yes
SyslogSuccess           yes
LogWhy                  yes

# Canonicalization algorithm
Canonicalization        relaxed/simple

# DKIM Mode - sign only, don't verify
Mode                    s

# Selector - matches DNS record
Selector                mail

# SubDomains - sign subdomains too
SubDomains              no

