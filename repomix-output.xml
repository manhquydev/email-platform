                                            <td className="px-4 py-3 font-mono text-xs" style={{ color: 'var(--nebula-text-secondary)' }}>[mã xác thực từ hệ thống]</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    {/* Domain List */}
                    {domains.length === 0 ? (
                        <div className="empty-state-nebula">
