                            cx="18" cy="18" r="16"
                            fill="none"
                            stroke="var(--nebula-violet)"
                            strokeWidth="2"
                            strokeDasharray={`${progressPercent} 100`}
                            strokeLinecap="round"
                            transform="rotate(-90 18 18)"
                            style={{ transition: 'stroke-dasharray 1s linear' }}
                        />
                    </svg>
                </div>
            </div>

            {/* OTP Code */}
