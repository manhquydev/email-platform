generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                 @id @default(uuid())
  email                      String                 @unique
  name                       String?
  passwordHash               String
  role                       UserRole               @default(USER)
  adminRole                  AdminRole?
  createdAt                  DateTime               @default(now())
  emailVerified              DateTime?
  verificationToken          String?
  verificationTokenExpiresAt DateTime?
  stripeCustomerId           String?                @unique
  stripeSubscriptionId       String?
  subscriptionStatus         SubscriptionStatus     @default(ACTIVE)
  tier                       SubscriptionTier       @default(FREE)
  subscriptionEndsAt         DateTime?
  trialEndsAt                DateTime?
  retentionDays              Int?                   // Custom retention period (null = use tier default)
  telegramChatId             String?                @unique
  telegramLinkedAt           DateTime?
  // Telegram Auth (Login Widget) - separate from chat notifications
  telegramId                 String?                @unique
  telegramUsername           String?
  telegramFirstName          String?
  telegramPhotoUrl           String?
  telegramAuthDate           DateTime?
  notifyOnEmail              Boolean                @default(true)
  verifiedForwardEmails      String[]
  twoFactorEnabled           Boolean                @default(false)
  twoFactorSecret            String?
  twoFactorBackupCodes       String[]
  isDisabled                 Boolean                @default(false)
  failedLoginAttempts        Int                    @default(0)
  lockedUntil                DateTime?
  auditLogs                  AuditLog[]
  authenticatorAccounts      AuthenticatorAccount[]
  domains                    Domain[]
  forwardVerifications       ForwardVerification[]
  forwardingRules            ForwardingRule[]
  inboxes                    Inbox[]
  telegramLinkTokens         TelegramLinkToken[]
  redemptions                CodeRedemption[]       @relation("UserRedemptions")
  payments                   Payment[]
  pendingPayments            PendingPayment[]
  passkeyCredentials         PasskeyCredential[]
  magicLinkTokens            MagicLinkToken[]
  notifications              Notification[]
  apiKeys                    ApiKey[]
  webhooks                   Webhook[]
  outboundMsgs               OutboundMessage[]
  ownedTeams                 Team[]             @relation("TeamOwner")
  teamMemberships            TeamMember[]       @relation("TeamMembership")
  supportTickets             SupportTicket[]
  ticketMessages             TicketMessage[]
  refreshTokens              RefreshToken[]     @relation("UserRefreshTokens")

  // Enterprise Multi-tenancy
  organizationId             String?
  organization               Organization?      @relation(fields: [organizationId], references: [id])
  organizationMemberships    OrganizationMember[]
  externalIdentities         ExternalIdentity[]

  // CalDAV & CardDAV
  calendars                  Calendar[]
  calendarShares             CalendarShare[]
  contacts                   Contact[]
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // For URL/subdomain resolution
  settings    Json?    // Branding, quotas, retention
  storageQuota BigInt   @default(0) // Bytes, 0 = unlimited
  storageUsed  BigInt   @default(0) // Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  domains     Domain[]
  users       User[]
  inboxes     Inbox[]
  contacts    Contact[] // Global Address List
  identityProviders IdentityProvider[]

  @@index([slug])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  keyHash    String    @unique
  prefix     String // First 8 chars for display
  name       String
  scopes     String[]  @default(["read"]) // SECURITY: API key scopes (Phase 2)
  lastUsedAt DateTime?
  expiresAt  DateTime? // Optional expiration date for the API key
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// SECURITY: RefreshToken model for secure token rotation (Phase 2 JWT Security)
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA256 hash of the refresh token
  userId    String
  familyId  String    // Token family for reuse detection
  usedAt    DateTime? // Null if not yet used, set when rotated
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime? // Set when explicitly revoked
  userAgent String?   // Device/browser info for session management
  ipAddress String?   // IP for security auditing

  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String?   // Optional for anonymous accounts
  credentialID String    @unique // Base64URL encoded
  publicKey    String // Base64URL encoded
  counter      BigInt
  transports   String[] // e.g. ["internal", "usb"]
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousAccount AnonymousAccount?

  @@index([userId])
}

// Phase 1: Anonymous Identity Layer - Mullvad-style accounts
model AnonymousAccount {
  id           String    @id @default(uuid())
  accountCode  String    @unique // Format: "xxxx-xxxx-xxxx-xxxx"
  visitorToken String?   @unique // For session recovery without passkey
  passkeyId    String?   @unique
  passkey      PasskeyCredential? @relation(fields: [passkeyId], references: [id])
  tier         String    @default("FREE")
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())

  @@index([accountCode])
  @@index([visitorToken])
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique // Hashed
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Domain {
  id                 String             @id @default(uuid())
  name               String             @unique
  status             DomainStatus       @default(PENDING)
  verificationToken  String
  createdAt          DateTime           @default(now())
  isPublic           Boolean            @default(false)
  ownerId            String?
  contributionStatus ContributionStatus @default(NONE)
  sharedAt           DateTime?
  shareNote          String?
  owner              User?              @relation(fields: [ownerId], references: [id])
  organizationId     String?
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  inboxes            Inbox[]
  dkim               DomainDkim?
  outboundMsgs       OutboundMessage[]

  @@index([ownerId])
  @@index([status])
}

model Inbox {
  id              String           @id @default(uuid())
  domainId        String
  localPart       String
  createdAt       DateTime         @default(now())
  expiresAt       DateTime?
  flags           Json?
  deletedAt       DateTime?
  claimedAt       DateTime         @default(now())
  ownerId         String?
  retentionDays   Int?             // Custom retention period (null = use user/global default)
  shareMode       ShareMode        @default(PRIVATE)
  emailFilters     EmailFilter[]
  visibilityRules  VisibilityRule[]
  forwardingRules ForwardingRule[]
  folders         Folder[]
  domain          Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  owner           User?            @relation(fields: [ownerId], references: [id])
  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  labels          Label[]
  messages        Message[]
  teamInboxes     TeamInbox[]

  @@unique([domainId, localPart])
  @@index([ownerId])
}

model Folder {
  id          String   @id @default(uuid())
  inboxId     String
  parentId    String?
  name        String
  specialUse  String?  // e.g. \Inbox, \Sent, \Drafts, \Trash, \Junk, \Archive
  uidValidity Int      @default(1)
  uidNext     Int      @default(1)
  subscribed  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inbox       Inbox    @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  parent      Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    Folder[] @relation("FolderHierarchy")
  messages    Message[]

  @@index([inboxId])
  @@index([parentId])
  @@unique([inboxId, parentId, name]) // Note: Prisma/Postgres unique with null might require handling
}

model MessageFlag {
  id        String   @id @default(uuid())
  messageId String
  flag      String   // \Seen, \Answered, \Flagged, \Deleted, \Draft, $Forwarded
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, flag])
  @@index([messageId])
}

model Message {
  id           String         @id @default(uuid())
  inboxId      String
  messageId    String?
  fromAddress  String?
  toAddress    String?
  subject      String?
  receivedAt   DateTime       @default(now())
  textBody     String?
  htmlBody     String?
  headers      Json?
  spamScore    Float?
  spfResult    String?
  dkimResult   String?
  dmarcResult  String?
  size         Int?
  sourceIp     String?
  deletedAt    DateTime?
  isRead       Boolean        @default(false)
  isPinned     Boolean        @default(false)
  snoozedUntil DateTime?

  // Folder & Threading Support
  folderId     String?
  uid          Int?      // IMAP UID
  threadId     String?   // Calculated thread ID

  folder       Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  flags        MessageFlag[]

  // OTP extraction data
  extractedOtp   String?
  otpConfidence  String?   // high, medium, low
  otpExtractedAt DateTime?

  // AI summarization data
  aiSummary      String?   @db.Text
  aiSummarizedAt DateTime?

  abuseReports AbuseReport[]
  attachments  Attachment[]
  inbox        Inbox          @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  labels       MessageLabel[]

  @@index([inboxId, receivedAt])
  @@index([folderId])
  @@index([threadId])
  @@index([uid])
  @@index([sourceIp, receivedAt])
  @@index([deletedAt])
  @@index([isPinned])
  @@index([extractedOtp])
}

model Attachment {
  id         String    @id @default(uuid())
  messageId  String
  filename   String
  mimeType   String?
  size       Int?
  storageKey String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  message    Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  meta      Json?
  ip        String?  // Request IP address
  userAgent String?  // Browser/client user agent
  requestId String?  // Request ID for correlation
  success   Boolean  @default(true) // Whether action succeeded
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ip])
  @@index([success])
}

model Rule {
  id        String    @id @default(uuid())
  type      RuleType
  scope     RuleScope
  value     String
  note      String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([scope, value])
}

model AbuseReport {
  id        String            @id @default(uuid())
  messageId String?
  reporter  String?
  reason    String
  status    AbuseReportStatus @default(OPEN)
  createdAt DateTime          @default(now())
  message   Message?          @relation(fields: [messageId], references: [id])

  @@index([status])
  @@index([messageId])
}

model EmailFilter {
  id          String          @id @default(uuid())
  inboxId     String
  name        String
  description String?
  matchType   FilterMatchType @default(ALL)
  conditions  Json
  actions     Json
  priority    Int             @default(0)
  isEnabled   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  inbox       Inbox           @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([inboxId, isEnabled])
}

model Label {
  id        String         @id @default(uuid())
  inboxId   String
  name      String
  color     String?
  parentId  String?
  createdAt DateTime       @default(now())
  inbox     Inbox          @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  parent    Label?         @relation("LabelHierarchy", fields: [parentId], references: [id])
  children  Label[]        @relation("LabelHierarchy")
  messages  MessageLabel[]

  @@unique([inboxId, name])
  @@index([inboxId])
}

model MessageLabel {
  id        String   @id @default(uuid())
  messageId String
  labelId   String
  createdAt DateTime @default(now())
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, labelId])
  @@index([labelId])
}

model AuthenticatorAccount {
  id          String   @id @default(uuid())
  userId      String
  serviceName String
  accountName String?
  secret      String
  issuer      String?
  algorithm   String   @default("SHA1")
  digits      Int      @default(6)
  period      Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TelegramLinkToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model ForwardingRule {
  id            String    @id @default(uuid())
  userId        String
  inboxId       String?
  name          String    @default("Unnamed Rule")

  // Destination configuration
  destinationType   ForwardDestinationType @default(EMAIL)
  forwardTo         String?                // For EMAIL
  telegramChatId    String?                // For TELEGRAM
  discordWebhookUrl String?                // For DISCORD
  webhookUrl        String?                // For WEBHOOK
  webhookSecret     String?                // For WEBHOOK signature

  // Matching configuration
  conditions    Json            @default("[]")
  matchType     FilterMatchType @default(ALL)
  priority      Int             @default(50)

  // Status
  isActive      Boolean   @default(true)
  forwardCount  Int       @default(0)
  lastForwardAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  inbox         Inbox?          @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          ForwardingLog[]

  @@index([userId, isActive])
  @@index([inboxId])
  @@index([priority])
}

model ForwardingLog {
  id              String   @id @default(uuid())
  ruleId          String
  messageId       String
  status          String   // SUCCESS, FAILED
  destination     String
  destinationType String
  duration        Int?
  error           String?
  createdAt       DateTime @default(now())

  rule ForwardingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([messageId])
  @@index([createdAt])
}

enum ForwardDestinationType {
  EMAIL
  TELEGRAM
  DISCORD
  WEBHOOK
}

model ForwardVerification {
  id         String    @id @default(uuid())
  userId     String
  email      String
  code       String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([email, code])
}

enum DomainStatus {
  PENDING
  VERIFIED
}

enum ContributionStatus {
  NONE
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  USER
}

enum RuleType {
  ALLOW
  BLOCK
}

enum RuleScope {
  SENDER_DOMAIN
  SENDER_EMAIL
  RECIPIENT_DOMAIN
  RECIPIENT_INBOX
  SOURCE_IP
}

enum AbuseReportStatus {
  OPEN
  REVIEWING
  CLOSED
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum FilterMatchType {
  ALL
  ANY
}

enum FilterConditionField {
  FROM
  TO
  SUBJECT
  BODY
  HAS_ATTACHMENT
}

enum FilterConditionOperator {
  CONTAINS
  NOT_CONTAINS
  EQUALS
  NOT_EQUALS
  STARTS_WITH
  ENDS_WITH
  REGEX
}

enum FilterActionType {
  MOVE_TO_FOLDER
  ADD_LABEL
  REMOVE_LABEL
  MARK_READ
  MARK_SPAM
  DELETE
  FORWARD
}

model ServicePackage {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @default(0)
  currency    String      @default("VND")
  type        PackageType

  // Time based params
  durationDays Int?
  targetTier   SubscriptionTier?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe integration
  stripePriceId   String?
  stripeProductId String?

  // Display configuration for pricing page
  features     Json?    // Array of { text: string, included: boolean }
  displayOrder Int      @default(0)
  recommended  Boolean  @default(false)
  badge        String?  // e.g. "KHUYÊN DÙNG", "PHỔ BIẾN"

  // Resource limits configuration (Single Source of Truth)
  // All tier limits managed here - replaces hardcoded TIER_LIMITS
  // Structure: { domains, inboxes, storageGB, dailyEmails, retentionDays, webhooks,
  //              apiAccess, prioritySupport, requestsPerMinute, inboxesPerDay, ... }
  limits       Json?

  codes RedemptionCode[]
  pendingPayments PendingPayment[]
}

model RedemptionCode {
  id        String    @id @default(uuid())
  code      String    @unique
  packageId String
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  status    String    @default("ACTIVE") // ACTIVE, USED, EXPIRED, REVOKED
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  package     ServicePackage   @relation(fields: [packageId], references: [id])
  redemptions CodeRedemption[] @relation("CodeUsage")
}

model CodeRedemption {
  id        String   @id @default(uuid())
  codeId    String
  userId    String
  createdAt DateTime @default(now())

  code RedemptionCode @relation("CodeUsage", fields: [codeId], references: [id])
  user User           @relation("UserRedemptions", fields: [userId], references: [id])

  @@unique([userId, codeId])
}

enum PackageType {
  TIME_BASED
  USAGE_BASED
}

model SystemSetting {
  key         String   @id // e.g., "RETENTION_DAYS", "MAINTENANCE_MODE"
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  amount          Decimal
  currency        String
  status          String // SUCCEEDED, FAILED, PENDING

  // Stripe fields (optional)
  stripePaymentId String?  @unique

  // SePay fields (new)
  sepayTransactionId String? @unique
  sepayReferenceCode String?
  paymentMethod      String  @default("STRIPE") // STRIPE, SEPAY

  packageId       String?
  createdAt       DateTime @default(now())
  paidAt          DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([paymentMethod])
}

model PendingPayment {
  id          String   @id @default(uuid())
  userId      String
  packageId   String
  orderCode   String   @unique  // Unique code for matching: EP_XXXXXXXX
  amount      Decimal
  currency    String   @default("VND")
  status      String   @default("PENDING") // PENDING, COMPLETED, EXPIRED
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  completedAt DateTime?

  user    User           @relation(fields: [userId], references: [id])
  package ServicePackage @relation(fields: [packageId], references: [id])

  @@index([orderCode])
  @@index([userId])
  @@index([status, expiresAt])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String? // Null if system-wide/all users (logic handled in app) or specific user
  type       NotificationType @default(INFO)
  title      String
  message    String           @db.Text
  imageUrl   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  templateId String?

  user     User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  template NotificationTemplate? @relation(fields: [templateId], references: [id])
  logs     NotificationLog[]

  @@index([userId])
  @@index([templateId])
  @@index([createdAt])
}

// Phase: Admin Notifications Upgrade - Templates, Logs, Scheduling

model NotificationTemplate {
  id         String           @id @default(uuid())
  name       String           @unique
  title      String
  message    String           @db.Text
  type       NotificationType @default(INFO)
  variables  Json?            // [{name: "username", required: true, description: "User name"}]
  imageUrl   String?
  isArchived Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  notifications          Notification[]
  scheduledNotifications ScheduledNotification[]

  @@index([isArchived])
  @@index([name])
}

model NotificationLog {
  id             String              @id @default(uuid())
  notificationId String
  channel        NotificationChannel
  status         DeliveryStatus
  errorMessage   String?
  metadata       Json?               // Telegram message_id, retry count, etc.
  sentAt         DateTime            @default(now())
  acknowledgedAt DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel, status])
  @@index([sentAt])
}

model ScheduledNotification {
  id           String         @id @default(uuid())
  templateId   String?
  title        String
  message      String         @db.Text
  type         NotificationType @default(INFO)
  imageUrl     String?
  targetMode   TargetMode
  targetUserId String?
  scheduledFor DateTime
  status       ScheduleStatus @default(PENDING)
  executedAt   DateTime?
  createdBy    String
  createdAt    DateTime       @default(now())

  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([status, scheduledFor])
  @@index([createdBy])
}

enum NotificationChannel {
  WEB
  TELEGRAM
  PUSH
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  ACKNOWLEDGED
}

enum ScheduleStatus {
  PENDING
  EXECUTED
  CANCELLED
  FAILED
}

enum TargetMode {
  SPECIFIC
  ALL
  SEGMENT
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  PROMOTION
}

model Webhook {
  id        String       @id @default(uuid())
  userId    String
  name      String
  url       String
  secret    String
  events    String[]     @default(["email.received"])
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      WebhookLog[]

  @@index([userId])
}

model WebhookLog {
  id           String   @id @default(uuid())
  webhookId    String
  eventType    String
  payload      Json
  statusCode   Int?
  responseBody String?
  duration     Int? // milliseconds
  createdAt    DateTime @default(now())
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
}

// Inbox-based Telegram linking models (Phase 01)

model InboxTelegramLink {
  id               String   @id @default(uuid())
  inboxEmail       String // "john@domain.com"
  telegramChatId   String
  telegramUsername String?
  createdAt        DateTime @default(now())
  status           String   @default("ACTIVE") // ACTIVE, PAUSED, REVOKED

  @@unique([inboxEmail, telegramChatId])
  @@index([inboxEmail])
  @@index([telegramChatId])
}

model InboxTelegramAuthToken {
  id         String    @id @default(uuid())
  inboxEmail String
  token      String    @unique // "inbox_XXXXXX" format
  expiresAt  DateTime // 24h from creation
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([inboxEmail])
}

model TelegramNotificationLog {
  id             String   @id @default(uuid())
  inboxEmail     String
  messageId      String // References Message.id
  telegramChatId String
  status         String // SENT, FAILED
  errorMessage   String?
  sentAt         DateTime @default(now())

  @@index([inboxEmail])
  @@index([telegramChatId])
  @@index([messageId])
}

// Phase 07: Outbound Mail Support Models

// Stores DKIM keypair per domain for email signing
model DomainDkim {
  id         String    @id @default(uuid())
  domainId   String    @unique
  selector   String // e.g., "ephemera2026"
  privateKey String // Encrypted PEM (AES-256-GCM)
  publicKey  String // For DNS TXT record display
  algorithm  String    @default("rsa-sha256")
  keySize    Int       @default(2048)
  createdAt  DateTime  @default(now())
  rotatedAt  DateTime?

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
}

// Tracks all outbound emails with delivery status
model OutboundMessage {
  id            String         @id @default(uuid())
  userId        String
  domainId      String
  inboxId       String? // Optional: if sent from specific inbox
  fromAddress   String
  toAddress     String
  subject       String?
  messageId     String         @unique // RFC 5322 Message-ID
  status        OutboundStatus @default(QUEUED)
  attempts      Int            @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  bouncedAt     DateTime?
  bounceType    BounceType?
  bounceSubType String? // ESP-specific code
  bounceMessage String?
  complaintType String? // "abuse", "fraud", etc.
  espMessageId  String? // Provider message ID
  espProvider   String? // "ses", "mailgun", "smtp"
  metadata      Json?
  createdAt     DateTime       @default(now())

  // Reply/Forward tracking
  inReplyTo        String? // In-Reply-To header value
  replyToMessageId String? // Reference to original Message.id

  user   User   @relation(fields: [userId], references: [id])
  domain Domain @relation(fields: [domainId], references: [id])

  @@index([userId])
  @@index([domainId])
  @@index([status])
  @@index([espMessageId])
  @@index([toAddress])
  @@index([createdAt])
  @@index([replyToMessageId])
}

// Prevents sending to invalid/complaining addresses
model BounceSuppressionList {
  id        String    @id @default(uuid())
  email     String    @unique
  reason    String // "hard_bounce", "complaint", "manual"
  sourceId  String? // OutboundMessage.id that caused suppression
  createdAt DateTime  @default(now())
  expiresAt DateTime? // Soft bounces can expire (e.g., 7 days)

  @@index([email])
  @@index([expiresAt])
}

enum OutboundStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

enum BounceType {
  HARD // Permanent - email does not exist
  SOFT // Temporary - mailbox full, server down
  COMPLAINT // Spam complaint
}

// Phase 08: Team Shared Inboxes

model Team {
  id          String       @id @default(uuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members     TeamMember[]
  sharedInboxes TeamInbox[]

  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  team User @relation("TeamMembership", fields: [userId], references: [id])
  teamRef Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

model TeamInbox {
  id        String   @id @default(uuid())
  teamId    String
  inboxId   String
  addedAt   DateTime @default(now())
  addedBy   String

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@unique([teamId, inboxId])
  @@index([teamId])
  @@index([inboxId])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ShareMode {
  PUBLIC
  PRIVATE
}

// Phase 09: Advanced Message Visibility Rules

enum VisibilityRuleType {
  HIDE       // Email matching conditions will not be shown to public
  SHOW_ONLY  // Only emails matching conditions will be shown (whitelist mode)
  WARN       // Email shown with warning icon/message
  REDACT     // Email shown but sensitive fields redacted
}

enum VisibilityAction {
  SHOWN
  HIDDEN
  WARNED
  REDACTED
}

model VisibilityRule {
  id          String             @id @default(uuid())
  inboxId     String
  name        String
  description String?
  ruleType    VisibilityRuleType
  matchType   FilterMatchType    @default(ALL)
  conditions  Json               // Array of VisibilityCondition
  priority    Int                @default(50) // 0-100, higher executes first
  isEnabled   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([inboxId, isEnabled, priority])
}

model VisibilityRuleTemplate {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  category    String             // security, banking, hr, custom
  ruleType    VisibilityRuleType
  matchType   FilterMatchType    @default(ALL)
  conditions  Json               // Array of VisibilityCondition
  isSystem    Boolean            @default(true)
  createdAt   DateTime           @default(now())
}

model MessageVisibilityAudit {
  id          String           @id @default(uuid())
  inboxId     String
  messageId   String
  action      VisibilityAction
  ruleId      String?
  ruleName    String?
  reason      String?
  requestedBy String?          // IP address or userId
  userAgent   String?
  createdAt   DateTime         @default(now())

  @@index([inboxId, createdAt])
  @@index([messageId])
}

// Phase 10: Browser Push Notifications
model PushSubscription {
  id                 String    @id @default(uuid())
  userId             String
  endpoint           String    @unique
  p256dh             String    // Public key
  auth               String    // Auth secret
  userAgent          String?
  createdAt          DateTime  @default(now())
  lastSuccessfulSend DateTime? // Track for stale subscription pruning

  @@index([userId])
  @@index([lastSuccessfulSend])
}

// Phase 11: Support Ticket System

enum TicketStatus {
  OPEN
  WAITING_USER
  WAITING_SUPPORT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  TECHNICAL
  BILLING
  ABUSE
  OTHER
}

model SupportTicket {
  id        String         @id @default(uuid())
  userId    String
  subject   String
  category  TicketCategory
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  closedAt  DateTime?

  user     User            @relation(fields: [userId], references: [id])
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  userId     String
  content    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

// Phase 06: CalDAV & CardDAV Models

model Calendar {
  id          String   @id @default(uuid())
  userId      String
  name        String
  color       String?  // Hex color
  timezone    String   @default("UTC")
  description String?
  ctag        Int      @default(1) // Collection tag for sync
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
  shares CalendarShare[]

  @@index([userId])
}

model CalendarShare {
  id           String   @id @default(uuid())
  calendarId   String
  sharedWithId String?  // Null if public
  permission   String   // READ, WRITE, ADMIN
  token        String?  // For public sharing
  createdAt    DateTime @default(now())

  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  sharedWith User?    @relation(fields: [sharedWithId], references: [id])

  @@index([calendarId])
  @@index([sharedWithId])
}

model Event {
  id          String   @id @default(uuid())
  calendarId  String
  uid         String   // iCal UID
  summary     String?
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  rrule       String?  // Recurrence rule
  icalData    String   @db.Text // Full iCal data
  etag        String   // Entity tag for sync
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, uid])
  @@index([calendarId, startAt, endAt])
}

model Contact {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?
  uid            String   // vCard UID
  fullName       String?
  email          String?
  phone          String?
  vcardData      String   @db.Text // Full vCard data
  etag           String   // Entity tag for sync
  isGal          Boolean  @default(false) // Global Address List entry
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([userId, uid])
  @@index([userId, email])
  @@index([organizationId, isGal])
}

model IdentityProvider {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String   // ldap, saml, oidc
  name           String
  config         Json     // Provider-specific config
  enabled        Boolean  @default(true)
  syncEnabled    Boolean  @default(false)
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  externalIdentities ExternalIdentity[]

  @@index([organizationId])
}

model ExternalIdentity {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  provider       IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  externalId     String   // IDP's user ID
  email          String
  attributes     Json?    // Additional SAML/OIDC claims
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([providerId, externalId])
  @@index([userId])
  @@index([email])
}
