    transform: scale(1.02);
}

.neo-hover-scale:active {
    transform: scale(0.98);
}

/* === SKELETON LOADING 2025 === */
.neo-skeleton {
    background: linear-gradient(90deg,
            var(--nebula-elevated) 25%,
            var(--nebula-border) 50%,
            var(--nebula-elevated) 75%);
