	if limit <= 0 {
		limit = 50
	}
	var resp PaginatedResponse[Message]
	path := fmt.Sprintf("/messages?inboxId=%s&limit=%d", inboxID, limit)
	if err := c.get(ctx, path, &resp); err != nil {
		return nil, err
	}
	return resp.Data, nil
}

