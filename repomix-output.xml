                            aria-label={tab.label}
                        >
                            <div className="relative">
                                {tab.icon}
                                <AnimatePresence>
                                    {tab.badge && tab.badge > 0 && (
                                        <motion.span
                                            initial={{ scale: 0, opacity: 0 }}
