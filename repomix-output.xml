}

export const PAGE_SIZE = 20;

export const TIER_OPTIONS = [
  { value: 'STARTER', label: 'Starter', description: '100 tenants, 1,000 mailboxes' },
  { value: 'GROWTH', label: 'Growth', description: '500 tenants, 5,000 mailboxes' },
