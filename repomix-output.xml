import { type ReactNode } from 'react';
import { useSwipeActions } from '../hooks/useSwipeActions';

interface SwipeableMessageProps {
    children: ReactNode;
    onSwipeLeft?: () => void;
    onSwipeRight?: () => void;
    leftLabel?: string;
    rightLabel?: string;
    leftColor?: string;
    rightColor?: string;
}

export function SwipeableMessage({
    children,
