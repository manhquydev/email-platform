    onVerifyDomain: (domainId: string, verifyToken: string) => Promise<void>;
    onDeleteDomain: (domain: Domain) => Promise<void>;
    onDeleteInbox: (inbox: Inbox) => Promise<void>;
    onExtendInbox: (inboxId: string) => Promise<void>;
    isAdmin: boolean;
    busy: boolean;
}

export function MobileSidebar({
    isOpen,
    onClose,
    domains,
    inboxes,
    selectedDomainId,
    selectedInboxId,
    currentUserId,
    onSelectDomain,
    onSelectInbox,
    onCreateDomain,
    onCreateInbox,
    onVerifyDomain,
    onDeleteDomain,
    onDeleteInbox,
    onExtendInbox,
    isAdmin,
    busy,
