                                            <span className="text-white font-medium select-all">{selectedMessage.toAddress}</span>
                                        </div>
                                    </div>
                                    <div className="text-xs text-text-tertiary whitespace-nowrap">
                                        {new Date(selectedMessage.receivedAt).toLocaleString('vi-VN')}
