/**
 * UI components for AdminSettingsPage
 * Profile card, System info card, 2FA section, Email verification, Password form
 */
import type { AdminProfile, SystemInfo, TwoFAStep } from "./types";

// --- Profile Card ---
export interface ProfileCardProps {
