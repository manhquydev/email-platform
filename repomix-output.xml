-- Step 2: Create foreign key constraint
-- Use IF NOT EXISTS pattern via DO block
DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_constraint 
        WHERE conname = 'Inbox_ownerId_fkey'
    ) THEN
        ALTER TABLE "Inbox" 
        ADD CONSTRAINT "Inbox_ownerId_fkey" 
        FOREIGN KEY ("ownerId") 
        REFERENCES "User"("id") 
        ON DELETE SET NULL 
        ON UPDATE CASCADE;
    END IF;
END
$$;

