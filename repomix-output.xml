interface OTPBannerProps {
    /** OTP extraction result */
    otp: OTPResult | null;
    /** Auto-copy on mount (opt-in) */
    autoCopy?: boolean;
    /** Callback when OTP is copied */
    onCopy?: (code: string) => void;
    /** Additional class names */
    className?: string;
