# Caddyfile - Production Reverse Proxy với HTTPS tự động
# ===================================================
# Sử dụng: Đặt biến môi trường DOMAIN trước khi chạy
# Ví dụ: DOMAIN=example.com docker-compose -f docker-compose.prod.yml up -d

{
	# Email cho Let's Encrypt notifications
	email {$ACME_EMAIL:admin@localhost}
}

# API Backend - api.yourdomain.com
{$DOMAIN:localhost}:443, api.{$DOMAIN:localhost} {
	reverse_proxy api:3001

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Logging
	log {
		output stdout
		format json
	}
}

# Web Frontend - app.yourdomain.com
app.{$DOMAIN:localhost} {
	reverse_proxy web:80

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Grafana Dashboard - grafana.yourdomain.com
# Chỉ nên mở nội bộ hoặc qua VPN
grafana.{$DOMAIN:localhost} {
	reverse_proxy grafana:3000

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Prometheus - metrics.yourdomain.com
# Khuyến nghị: Chỉ mở nội bộ hoặc bảo vệ bằng basic_auth
prometheus.{$DOMAIN:localhost} {
	reverse_proxy prometheus:9090

	# Uncomment to enable basic auth:
	# basic_auth {
	#     admin $2a$14$... # caddy hash-password
	# }

	header {
		-Server
	}

	log {
		output stdout
		format json
	}
}

# SMTP không đi qua Caddy (port 25, 587 - không phải HTTP)
# Cấu hình firewall/iptables riêng cho SMTP traffic

# Local development fallback (khi DOMAIN không được set)
:80 {
	respond "Caddy is running. Set DOMAIN env var for production." 200
}
