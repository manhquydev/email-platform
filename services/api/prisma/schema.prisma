generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum RuleType {
  ALLOW
  BLOCK
  FORWARD
}

enum RuleScope {
  GLOBAL
  DOMAIN
  USER
}

enum AbuseReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum SsoProvider {
  SAML
  OIDC
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum WebhookStatus {
  ACTIVE
  INACTIVE
  FAILED
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String?
  role                  Role      @default(USER)
  emailVerified         DateTime
  verificationToken     String?
  verificationTokenExpiresAt DateTime?
  twoFactorEnabled      Boolean   @default(false)
  twoFactorSecret       String?
  twoFactorBackupCodes  String[]
  isDisabled            Boolean   @default(false)
  tier                  String    @default("free") // free, premium, business
  source                String?   // direct, referral, social
  resetToken            String?
  resetExpiresAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastActiveAt          DateTime? @default(now())

  // Relations
  domains               Domain[]
  abuseReports          AbuseReport[]
  auditLogs             AuditLog[]
  organizations         OrganizationMember[]
  ownedOrganizations   Organization[] @relation("OrganizationOwner")
  messages              Message[]
  apiKeys               ApiKey[]
  webhooks              Webhook[]
  userQuota             UserQuota?
  usageTrackers         UsageTracker[]
  referralCodeId        String?
  notifications         Notification[]
  settings              Json?
}

model Domain {
  id                String            @id @default(uuid())
  name              String            @unique
  owner             User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId           String?
  verificationToken String?
  verifiedAt        DateTime?
  isActive          Boolean           @default(true)
  status            String            @default("active")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organizationId    String?

  // Relations
  inboxes           Inbox[]
  messages          Message[]         @relation("DomainMessages")
  organization      Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([organizationId])
  @@index([isActive])
  @@index([status])
}

model Inbox {
  id           String   @id @default(uuid())
  domain       Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId     String
  address      String   @unique
  isActive     Boolean  @default(true)
  description  String?
  autoDelete   Boolean  @default(false)
  deleteAfter  Int?     // Hours
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  expiresAt    DateTime?
  organizationId String?

  // Relations
  messages     Message[]
  rules        Rule[]
  abuseReports AbuseReport[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([domainId])
  @@index([organizationId])
  @@index([expiresAt])
}

model Message {
  id              String   @id @default(uuid())
  inbox           Inbox    @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  inboxId         String
  domain          Domain?  @relation("DomainMessages", fields: [domainId], references: [id])
  domainId        String?
  fromAddress     String
  toAddress       String
  subject         String?
  textContent     String?
  htmlContent     String?
  sourceIp        String?
  rawEmail        String? // Store original email
  read            Boolean  @default(false)
  pinned          Boolean  @default(false)
  deletedAt       DateTime?
  isRead          Boolean  @default(false)
  isPinned         Boolean  @default(false)
  snoozedUntil    DateTime?
  bounced         Boolean  @default(false)
  bouncedAt       DateTime?
  bounceReason    String?
  complained      Boolean  @default(false)
  complainedAt    DateTime?
  rejected        Boolean  @default(false)
  rejectedAt      DateTime?
  rejectReason    String?
  delivered       Boolean  @default(false)
  deliveredAt     DateTime?
  attachments     Attachment[]
  abuseReports    AbuseReport[]
  labels          MessageLabel[]
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  receivedAt      DateTime @default(now())
  userId          String?

  @@index([inboxId, receivedAt])
  @@index([deletedAt])
  @@index([isPinned])
  @@index([bounced])
  @@index([complained])
  @@index([userId])
  @@index([domainId])
}

model Attachment {
  id          String   @id @default(uuid())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId   String
  filename    String
  mimeType    String?
  size        Int?
  storageKey  String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

model Rule {
  id        String    @id @default(uuid())
  type      RuleType
  scope     RuleScope
  field     String?   // e.g., 'FROM', 'TO', 'SUBJECT'
  pattern   String
  active    Boolean   @default(true)
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  inboxId   String?
  inbox     Inbox?    @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([scope, pattern])
  @@index([active])
  @@index([inboxId])
}

model AbuseReport {
  id         String            @id @default(uuid())
  message    Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageId  String?
  reporter   String?
  reporterId String?
  inbox      Inbox?            @relation(fields: [inboxId], references: [id], onDelete: SetNull)
  inboxId    String?
  user       User?             @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reason     String
  status     AbuseReportStatus @default(OPEN)
  createdAt  DateTime          @default(now())

  @@index([status])
  @@index([messageId])
  @@index([reporterId])
  @@index([inboxId])
}

// Organization models for B2B features
model Organization {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  logo        String?
  domain      String?
  settings    Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  ownerId     String?

  // Relations
  owner           User?                @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members         OrganizationMember[]
  domains         Domain[]
  settingsObj     OrganizationSettings?
  subscription    OrganizationSubscription?
  inboxes         Inbox[]
  apiKeys          ApiKey[]
  webhooks         Webhook[]

  @@index([slug])
  @@index([isActive])
}

model OrganizationMember {
  id           String           @id @default(uuid())
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  role         OrganizationRole  @default(MEMBER)
  permissions  Json?
  invitedBy    String?
  invitedAt    DateTime?
  joinedAt     DateTime         @default(now())
  lastActiveAt DateTime?
  isActive     Boolean          @default(true)

  @@unique([organizationId, userId])
  @@index([organizationId, userId])
  @@index([role])
}

model OrganizationSettings {
  id              String            @id @default(uuid())
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId   String            @unique
  ssoEnabled       Boolean           @default(false)
  ssoProvider      SsoProvider?
  ssoConfig        Json?
  apiAccessEnabled Boolean           @default(false)
  webhooksEnabled  Boolean           @default(false)
  customTheme      Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId])
}

model ApiKey {
  id            String         @id @default(uuid())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user          User              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy     String
  name          String
  keyPrefix     String         @default("tmp_")
  keyHash       String
  keyLastFour   String
  permissions   Json?          // Array of permissions
  status        ApiKeyStatus   @default(ACTIVE)
  rateLimit     Int?
  usageCount    Int            @default(0)
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  deliveries    ApiUsageLog[]

  @@index([organizationId])
  @@index([createdBy])
  @@index([status])
}

model ApiUsageLog {
  id          String  @id @default(uuid())
  apiKey      ApiKey  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  apiKeyId    String
  method      String
  endpoint    String
  statusCode  Int
  responseTime Int
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([apiKeyId])
  @@index([createdAt])
}

model Webhook {
  id            String         @id @default(uuid())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user          User              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy     String
  name          String
  url           String
  secret        String?       // Optional secret for signing
  events        Json          // Array of event types
  status        WebhookStatus @default(ACTIVE)

  // Delivery settings
  timeout       Int?          // Timeout in seconds
  retryAttempts Int           @default(3)
  retryDelay    Int           @default(60) // Seconds between retries

  // Metadata
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  deliveries    WebhookDelivery[]

  @@index([organizationId])
  @@index([createdBy])
  @@index([status])
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  webhookId   String
  eventType   String
  payload     Json
  statusCode  Int?
  response    String?
  duration    Int?     // Delivery time in ms
  attempt     Int      // Attempt number

  // Status
  status      String   // "pending", "delivered", "failed"
  error       String?

  scheduledAt DateTime @default(now())
  deliveredAt DateTime?

  createdAt   DateTime @default(now())

  @@index([webhookId])
  @@index([status])
  @@index([scheduledAt])
}

model OrganizationSubscription {
  id                    String              @id @default(uuid())
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId        String  @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripePriceId         String?
  tier                  SubscriptionTier    @default(FREE)
  status                SubscriptionStatus   @default(ACTIVE)
  billingEmail           String
  paymentMethodId       String?
  billingPeriod          String
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  usage                  Json?
  limits                 Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([billingPeriod])
}

model MessageLabel {
  id        String  @id @default(uuid())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  label     String
  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([label])
}

// Public tier models for Phase 3
model UserQuota {
  id                  String   @id @default(uuid())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String   @unique
  maxDomains          Int      @default(1)
  maxInboxes          Int      @default(10)
  maxEmailsPerMonth   Int      @default(100)
  emailRetentionHours Int      @default(24)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

model UsageTracker {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  metric      String   // emails_sent, emails_received, storage_used
  value       Int      @default(0)
  period      String   // daily, monthly, yearly
  periodStart DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([metric])
  @@index([period])
}

model ReferralCode {
  id            String  @id @default(uuid())
  code          String  @unique
  referrerId    String?
  referralCount Int     @default(0)
  active        Boolean @default(true)
  createdAt     DateTime @default(now())

  @@index([referrerId])
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String   // quota_warning, quota_exceeded, trial_ending, upgrade_suggestion
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([type])
}