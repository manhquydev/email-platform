}

.landing-feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--nebula-glow-violet);
    border-radius: var(--nebula-radius-lg);
    margin-bottom: var(--nebula-space-md);
    color: var(--nebula-violet);
}

.landing-feature-icon svg {
    width: 24px;
    height: 24px;
}

.landing-feature-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--nebula-text);
    margin-bottom: var(--nebula-space-sm);
}

