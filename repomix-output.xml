                            </GlassCard>

                            <GlassCard className="p-8">
                                <h2 className="text-2xl font-bold mb-6">Endpoints</h2>
                                <div className="space-y-4">
                                    {[
                                        { method: "POST", path: "/inboxes", desc: "Tạo inbox mới" },
                                        { method: "GET", path: "/inboxes", desc: "Liệt kê inbox" },
